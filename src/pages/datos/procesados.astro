---
/**
 * Datos procesados: cuánto material leyó el sitio para escribir lo que publica, y sobre quién.
 *
 * Un lector pidió seguir qué se descargó (notas, PDF, planillas, videos), cuántos tokens se
 * procesaron, y poder filtrarlo por político, empresa pública, investigación o tema; después pidió
 * verlo en gráficos y no en tablas. Los números salen de `data/corpus-estadisticas.json` y
 * `data/corpus-notas.json`, que genera `pnpm corpus:estadisticas` en la máquina donde vive el
 * corpus (el corpus es privado: texto completo de notas con derechos; cuánto y qué se leyó, no).
 *
 * Los gráficos los dibuja `src/lib/graficos-corpus.ts`, una vez al construir (el estado sin
 * filtros) y otra vez en el navegador cada vez que el lector filtra, con el mismo código: barras
 * por día para lo que entró en el tiempo, barras horizontales para lo que se reparte entre tipos,
 * medios, personas, empresas, temas y eventos. Las tablas de valores van plegadas.
 *
 * Honestidad de las cifras: «tokens» es una estimación de unos cuatro caracteres por token sobre
 * el texto extraído de cada fuente. No incluye lo que los agentes consumen al razonar ni al
 * releer, que el sitio no registra. Los filtros corren en el navegador sobre una fila por fuente
 * (tipo, medio, largo, día, etiquetas), sin texto ni URL.
 */
import Base from '../../layouts/Base.astro';
import { publicados } from '../../lib/contenido';
import { ruta } from '../../lib/ruta';
import { barrasHorizontales, barrasPorDia, enteros, M, tokens, type FilaBarra } from '../../lib/graficos-corpus';
import estadisticas from '../../../data/corpus-estadisticas.json';

const [politicos, eventos, temas, empresas, medios] = await Promise.all([publicados('politicos'), publicados('eventos'), publicados('temas'), publicados('empresas'), publicados('medios')]);
const nombrePolitico = new Map(politicos.map((p) => [p.id, p.data.nombre_corto]));
const nombreEvento = new Map(eventos.map((e) => [e.id, e.data.nombre]));
const nombreTema = new Map(temas.map((t) => [t.id, t.data.nombre]));
const nombreEmpresa = new Map(empresas.map((e) => [e.id, e.data.nombre]));
const nombreMedio = new Map(medios.map((m) => [m.id, m.data.nombre]));
const e = estadisticas;
const GB = (b: number) => `${(b / 1e9).toFixed(1)} GB`;
const NOMBRE_TIPO: Record<string, string> = { pdf: 'Documentos PDF', html: 'Notas y páginas web', texto: 'Planillas, JSON y texto', video: 'Videos y audios transcriptos', xlsx: 'Planillas', '': 'Sin tipo' };
const fallidas = e.lecturas.por_resultado.filter((r) => r.resultado !== 'ok').reduce((s, r) => s + r.n, 0);
const TOPE = 20;

/* Estado sin filtros, dibujado al construir. El navegador redibuja lo mismo desde la lista compacta. */
const filaTipo = (t: { tipo: string; n: number; chars: number }, metrica: 'fuentes' | 'tokens'): FilaBarra => ({
  clave: t.tipo,
  nombre: NOMBRE_TIPO[t.tipo] ?? t.tipo,
  valor: metrica === 'fuentes' ? t.n : tokens(t.chars),
  detalle: metrica === 'fuentes' ? `${M(tokens(t.chars))} tokens` : `${enteros(t.n)} fuentes`,
});
const g = {
  diaFuentes: barrasPorDia(e.por_dia, 'fuentes', 'Fuentes leídas por día'),
  diaTokens: barrasPorDia(e.por_dia, 'tokens', 'Tokens estimados por día'),
  tipoFuentes: barrasHorizontales(e.por_tipo.map((t) => filaTipo(t, 'fuentes'))),
  tipoTokens: barrasHorizontales(e.por_tipo.map((t) => filaTipo(t, 'tokens')), M),
  medio: barrasHorizontales(
    e.por_medio.slice(0, TOPE).map((m) => ({ clave: m.medio, nombre: nombreMedio.get(m.medio) ?? m.medio, href: nombreMedio.has(m.medio) ? ruta(`/medios/${m.medio}/`) : undefined, valor: tokens(m.chars), detalle: `${enteros(m.n)} fuentes` })),
    M,
  ),
  politico: barrasHorizontales(e.por_politico.slice(0, TOPE).map((p) => ({ clave: p.politico, nombre: nombrePolitico.get(p.politico) ?? p.politico, href: nombrePolitico.has(p.politico) ? ruta(`/politicos/${p.politico}/`) : undefined, valor: p.n }))),
  empresa: barrasHorizontales(
    e.por_empresa.slice(0, TOPE).map((x) => ({ clave: x.empresa, nombre: nombreEmpresa.get(x.empresa) ?? x.empresa, href: nombreEmpresa.has(x.empresa) ? ruta(`/empresas/${x.empresa}/`) : undefined, valor: tokens(x.chars), detalle: `${enteros(x.n)} fuentes` })),
    M,
  ),
  tema: barrasHorizontales(e.por_tema.slice(0, TOPE).map((x) => ({ clave: x.tema, nombre: nombreTema.get(x.tema) ?? x.tema, href: nombreTema.has(x.tema) ? ruta(`/temas/${x.tema}/`) : undefined, valor: x.n }))),
  evento: barrasHorizontales(e.por_evento.slice(0, TOPE).map((x) => ({ clave: x.evento, nombre: nombreEvento.get(x.evento) ?? x.evento, href: nombreEvento.has(x.evento) ? ruta(`/eventos/${x.evento}/`) : undefined, valor: x.n }))),
};
const configuracion = {
  urlNotas: ruta('/datos/corpus-notas.json'),
  base: ruta('/'),
  tope: TOPE,
  tipos: NOMBRE_TIPO,
  nombres: {
    politicos: Object.fromEntries(nombrePolitico),
    empresas: Object.fromEntries(nombreEmpresa),
    eventos: Object.fromEntries(nombreEvento),
    temas: Object.fromEntries(nombreTema),
    medios: Object.fromEntries(nombreMedio),
  },
};
---

<Base
  titulo="Datos procesados"
  descripcion="Cuánto material leyó el sitio para escribir lo que publica: fuentes, documentos, planillas y videos, caracteres y tokens estimados, por día, por tipo, por medio, por político, empresa pública, evento y tema."
>
  <h1>Datos procesados</h1>
  <p class="prosa">
    Todo lo que el sitio afirma sale de fuentes que se leyeron enteras y quedaron guardadas. Esta página cuenta ese material: cuántas fuentes,
    de qué tipo, de qué medios, cuánto texto, y sobre quién. Los filtros redibujan todo en el navegador.
  </p>
  <details class="chico prosa">
    <summary>Qué mide cada número y qué no</summary>
    <p>
      «Fuentes» son documentos leídos con la herramienta de lectura del sitio (una nota, un PDF, una planilla, un video transcripto). «Tokens»
      es una estimación de unos cuatro caracteres por token sobre el texto extraído; no incluye lo que los agentes consumen al razonar ni al
      releer, que no se registra. «Lecturas intentadas» cuenta también lo que no se pudo bajar (enlaces caídos, accesos denegados), con el
      resultado de cada intento. Una fuente que menciona a varias personas cuenta para cada una. Actualizado el {e.generado}.
    </p>
  </details>

  <div class="filtros" id="filtros">
    <label>
      Político
      <select id="f-politico">
        <option value="">Todos</option>
        {e.por_politico.map((p) => (
          <option value={p.politico}>
            {nombrePolitico.get(p.politico) ?? p.politico} ({p.n})
          </option>
        ))}
      </select>
    </label>
    <label>
      Empresa pública
      <select id="f-empresa">
        <option value="">Todas</option>
        {e.por_empresa.map((x) => (
          <option value={x.empresa}>
            {nombreEmpresa.get(x.empresa) ?? x.empresa} ({x.n})
          </option>
        ))}
      </select>
    </label>
    <label>
      Evento o investigación
      <select id="f-evento">
        <option value="">Todos</option>
        {e.por_evento.map((x) => (
          <option value={x.evento}>
            {nombreEvento.get(x.evento) ?? x.evento} ({x.n})
          </option>
        ))}
      </select>
    </label>
    <label>
      Tema
      <select id="f-tema">
        <option value="">Todos</option>
        {e.por_tema.map((x) => (
          <option value={x.tema}>
            {nombreTema.get(x.tema) ?? x.tema} ({x.n})
          </option>
        ))}
      </select>
    </label>
    <button type="button" id="f-limpiar" class="chico" hidden>Quitar filtros</button>
    <p class="chico" id="f-estado">Sin filtros: todo el corpus.</p>
  </div>

  <section class="tarjetas" id="totales">
    <div class="tarjeta dato"><span class="cifra" data-total="fuentes">{enteros(e.totales.fuentes)}</span><span class="rotulo">fuentes leídas</span></div>
    <div class="tarjeta dato"><span class="cifra" data-total="caracteres">{M(e.totales.caracteres)}</span><span class="rotulo">caracteres de texto</span></div>
    <div class="tarjeta dato"><span class="cifra" data-total="tokens">{M(e.totales.tokens_estimados)}</span><span class="rotulo">tokens (estimación)</span></div>
    <div class="tarjeta dato"><span class="cifra">{GB(e.totales.bytes_en_disco)}</span><span class="rotulo">en disco (originales y texto)</span></div>
    <div class="tarjeta dato"><span class="cifra">{e.totales.transcripciones}</span><span class="rotulo">videos y audios transcriptos ({e.totales.horas_transcriptas} h)</span></div>
    <div class="tarjeta dato"><span class="cifra">{e.totales.lecturas_intentadas}</span><span class="rotulo">lecturas intentadas, {fallidas} fallidas</span></div>
  </section>

  <section>
    <h2>Por día</h2>
    <div class="par">
      <figure class="grafico">
        <figcaption>Fuentes leídas por día</figcaption>
        <div id="g-dia-fuentes" set:html={g.diaFuentes} />
      </figure>
      <figure class="grafico">
        <figcaption>Tokens estimados por día</figcaption>
        <div id="g-dia-tokens" set:html={g.diaTokens} />
      </figure>
    </div>
    <details class="chico">
      <summary>Tabla de valores por día</summary>
      <table id="t-dia">
        <thead>
          <tr>
            <th scope="col">Día</th>
            <th scope="col">Fuentes</th>
            <th scope="col">Caracteres</th>
            <th scope="col">Tokens (estimación)</th>
          </tr>
        </thead>
        <tbody>
          {e.por_dia.map((d) => (
            <tr>
              <th scope="row">{d.dia}</th>
              <td>{enteros(d.n)}</td>
              <td>{M(d.chars)}</td>
              <td>{M(tokens(d.chars))}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </details>
  </section>

  <section>
    <h2>Por tipo de fuente</h2>
    <div class="par">
      <figure class="grafico">
        <figcaption>Fuentes</figcaption>
        <div id="g-tipo-fuentes" set:html={g.tipoFuentes} />
      </figure>
      <figure class="grafico">
        <figcaption>Tokens (estimación)</figcaption>
        <div id="g-tipo-tokens" set:html={g.tipoTokens} />
      </figure>
    </div>
  </section>

  <section>
    <h2>Por medio o publicador</h2>
    <figure class="grafico">
      <figcaption>Tokens estimados por publicador, los {TOPE} con más texto; el nombre lleva a su ficha de medio</figcaption>
      <div id="g-medio" set:html={g.medio} />
    </figure>
  </section>

  <section>
    <h2>Por político</h2>
    <figure class="grafico">
      <figcaption>Fuentes que mencionan a cada persona, las {TOPE} más mencionadas</figcaption>
      <div id="g-politico" set:html={g.politico} />
    </figure>
  </section>

  <section>
    <h2>Por empresa pública</h2>
    <figure class="grafico">
      <figcaption>Tokens estimados de los documentos que publica cada empresa (balances, memorias, planillas)</figcaption>
      <div id="g-empresa" set:html={g.empresa} />
    </figure>
  </section>

  <section>
    <h2>Por tema</h2>
    <figure class="grafico">
      <figcaption>Fuentes etiquetadas con cada tema</figcaption>
      <div id="g-tema" set:html={g.tema} />
    </figure>
  </section>

  <section>
    <h2>Por evento o investigación</h2>
    <figure class="grafico">
      <figcaption>Fuentes etiquetadas con cada evento o caso</figcaption>
      <div id="g-evento" set:html={g.evento} />
    </figure>
  </section>

  <section>
    <h2>Lecturas que fallaron</h2>
    <p class="chico">De {e.totales.lecturas_intentadas} lecturas intentadas, {fallidas} no se pudieron completar. Los dominios con más fallas:</p>
    <figure class="grafico">
      <figcaption>Lecturas fallidas por dominio</figcaption>
      <div
        set:html={barrasHorizontales(
          e.lecturas.por_dominio
            .filter((d) => d.fallidas > 0)
            .sort((a, b) => b.fallidas - a.fallidas)
            .slice(0, 15)
            .map((d) => ({ clave: d.dominio, nombre: d.dominio, valor: d.fallidas, detalle: `de ${d.n} intentos` })),
        )}
      />
    </figure>
  </section>

  <p class="chico">
    Los números crudos: <a href={ruta('/datos/corpus-estadisticas.json')}>corpus-estadisticas.json</a> y, fila por fuente,{' '}
    <a href={ruta('/datos/corpus-notas.json')}>corpus-notas.json</a>. El resto de los datos abiertos, en <a href={ruta('/datos/')}>datos</a>.
  </p>
</Base>

<script type="application/json" id="corpus-datos" set:html={JSON.stringify(configuracion)} />
<script>
  // Filtros del lado del lector: baja la lista compacta (una fila por fuente) y redibuja los totales
  // y todos los gráficos con el mismo dibujante que usó la construcción del sitio.
  import { agregar, barrasHorizontales, barrasPorDia, enteros, M, tokens, type Agregado, type FilaBarra, type NotaCompacta } from '../../lib/graficos-corpus';

  const cfg = JSON.parse(document.getElementById('corpus-datos')!.textContent!) as {
    urlNotas: string;
    base: string;
    tope: number;
    tipos: Record<string, string>;
    nombres: Record<'politicos' | 'empresas' | 'eventos' | 'temas' | 'medios', Record<string, string>>;
  };
  const sel = {
    politico: document.getElementById('f-politico') as HTMLSelectElement,
    empresa: document.getElementById('f-empresa') as HTMLSelectElement,
    evento: document.getElementById('f-evento') as HTMLSelectElement,
    tema: document.getElementById('f-tema') as HTMLSelectElement,
  };
  const limpiar = document.getElementById('f-limpiar') as HTMLButtonElement;
  const estado = document.getElementById('f-estado')!;
  const poner = (id: string, html: string) => {
    const el = document.getElementById(id);
    if (el) el.innerHTML = html;
  };
  let notas: NotaCompacta[] | null = null;

  const filas = (pares: [string, Agregado][], coleccion: keyof typeof cfg.nombres, seccion: string, metrica: 'fuentes' | 'tokens'): FilaBarra[] =>
    pares.slice(0, cfg.tope).map(([k, a]) => ({
      clave: k,
      nombre: cfg.nombres[coleccion][k] ?? k,
      href: cfg.nombres[coleccion][k] ? `${cfg.base}${seccion}/${k}/` : undefined,
      valor: metrica === 'fuentes' ? a.n : tokens(a.chars),
      detalle: metrica === 'tokens' ? `${enteros(a.n)} fuentes` : undefined,
    }));

  const aplicar = () => {
    if (!notas) return;
    const f = { p: sel.politico.value, e: sel.empresa.value, v: sel.evento.value, x: sel.tema.value };
    const activo = Object.values(f).some(Boolean);
    limpiar.hidden = !activo;
    const sub = notas.filter((n) => (!f.p || n.p.includes(f.p)) && (!f.e || n.e === f.e) && (!f.v || n.v.includes(f.v)) && (!f.x || n.x.includes(f.x)));
    const a = agregar(sub);
    document.querySelector('[data-total="fuentes"]')!.textContent = enteros(a.fuentes);
    document.querySelector('[data-total="caracteres"]')!.textContent = M(a.chars);
    document.querySelector('[data-total="tokens"]')!.textContent = M(tokens(a.chars));
    poner('g-dia-fuentes', barrasPorDia(a.dia, 'fuentes', 'Fuentes leídas por día'));
    poner('g-dia-tokens', barrasPorDia(a.dia, 'tokens', 'Tokens estimados por día'));
    const tbody = document.querySelector('#t-dia tbody');
    if (tbody) tbody.innerHTML = a.dia.map((d) => `<tr><th scope="row">${d.dia}</th><td>${enteros(d.n)}</td><td>${M(d.chars)}</td><td>${M(tokens(d.chars))}</td></tr>`).join('');
    const tipo = (metrica: 'fuentes' | 'tokens'): FilaBarra[] =>
      a.tipo.map(([k, x]) => ({
        clave: k,
        nombre: (cfg.tipos[k] ?? k) || 'Sin tipo',
        valor: metrica === 'fuentes' ? x.n : tokens(x.chars),
        detalle: metrica === 'fuentes' ? `${M(tokens(x.chars))} tokens` : `${enteros(x.n)} fuentes`,
      }));
    poner('g-tipo-fuentes', barrasHorizontales(tipo('fuentes')));
    poner('g-tipo-tokens', barrasHorizontales(tipo('tokens'), M));
    poner('g-medio', barrasHorizontales(filas(a.medio.sort((p, q) => q[1].chars - p[1].chars), 'medios', 'medios', 'tokens'), M));
    poner('g-politico', barrasHorizontales(filas(a.politico, 'politicos', 'politicos', 'fuentes')));
    poner('g-empresa', barrasHorizontales(filas(a.empresa.sort((p, q) => q[1].chars - p[1].chars), 'empresas', 'empresas', 'tokens'), M));
    poner('g-tema', barrasHorizontales(filas(a.tema, 'temas', 'temas', 'fuentes')));
    poner('g-evento', barrasHorizontales(filas(a.evento, 'eventos', 'eventos', 'fuentes')));
    const partes: string[] = [];
    if (f.p) partes.push(cfg.nombres.politicos[f.p] ?? f.p);
    if (f.e) partes.push(cfg.nombres.empresas[f.e] ?? f.e);
    if (f.v) partes.push(cfg.nombres.eventos[f.v] ?? f.v);
    if (f.x) partes.push(cfg.nombres.temas[f.x] ?? f.x);
    estado.textContent = activo ? `Filtrado por ${partes.join(' · ')}: ${enteros(a.fuentes)} fuentes.` : 'Sin filtros: todo el corpus.';
  };
  for (const s of Object.values(sel)) s.addEventListener('change', aplicar);
  limpiar.addEventListener('click', () => {
    for (const s of Object.values(sel)) s.value = '';
    aplicar();
  });
  fetch(cfg.urlNotas)
    .then((r) => r.json())
    .then((d) => {
      notas = d.notas as NotaCompacta[];
    })
    .catch(() => {
      estado.textContent = 'No se pudo cargar la lista para filtrar; se muestra todo el corpus.';
    });
</script>

<style is:global>
  /* Los gráficos se inyectan como HTML (al construir y al filtrar), así que sus estilos son globales. */
  .hbar {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.3rem;
    font-size: var(--t-sm);
  }
  .hbar li {
    display: grid;
    grid-template-columns: minmax(7rem, 12rem) 1fr minmax(5rem, auto);
    align-items: center;
    gap: 0.6rem;
  }
  .hbar .k {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hbar .b {
    display: block;
    height: 0.9rem;
    background: color-mix(in srgb, var(--borde) 55%, transparent);
    border-radius: 2px;
    overflow: hidden;
  }
  .hbar .b i {
    display: block;
    height: 100%;
    background: var(--acento);
    border-radius: 2px;
  }
  .hbar .v {
    color: var(--texto-2);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .hbar .v small {
    color: var(--texto-3);
  }
  .g-dia {
    width: 100%;
    height: auto;
    display: block;
    font-size: 11px;
  }
  .g-dia .reja {
    stroke: var(--borde);
    stroke-width: 1;
  }
  .g-dia .eje,
  .g-dia .valor {
    fill: var(--texto-3);
  }
  .g-dia .valor {
    font-weight: 600;
    fill: var(--texto-2);
  }
  .g-dia .barra {
    fill: var(--acento);
  }
  @media (max-width: 40rem) {
    .hbar li {
      grid-template-columns: minmax(5rem, 8rem) 1fr auto;
    }
  }
</style>

<style>
  .prosa {
    max-width: var(--ancho-prosa);
  }
  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2) var(--e-3);
    align-items: end;
    margin: var(--e-3) 0;
  }
  .filtros label {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: var(--t-sm);
    color: var(--texto-2);
  }
  .filtros select {
    font: inherit;
    max-width: 18rem;
  }
  .filtros p {
    flex-basis: 100%;
    margin: 0;
  }
  .tarjetas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--e-2);
    margin: var(--e-3) 0;
  }
  .dato {
    margin: 0;
    padding: var(--e-3);
    display: flex;
    flex-direction: column;
  }
  .cifra {
    font-size: var(--t-xl);
    font-weight: 700;
  }
  .rotulo {
    color: var(--texto-3);
    font-size: var(--t-sm);
  }
  section {
    margin-top: var(--e-4);
  }
  .par {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--e-3) var(--e-4);
  }
  figure.grafico {
    margin: var(--e-2) 0;
  }
  figure.grafico figcaption {
    font-size: var(--t-sm);
    color: var(--texto-2);
    margin-bottom: 0.4rem;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: var(--t-sm);
  }
  th,
  td {
    text-align: left;
    padding: 0.35rem 0.6rem;
    border-bottom: 1px solid var(--borde);
  }
</style>

