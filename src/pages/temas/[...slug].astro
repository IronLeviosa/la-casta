---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Timeline, { type ItemTimeline } from '../../components/Timeline.astro';
import GiroCard from '../../components/GiroCard.astro';
import PromesaCard from '../../components/PromesaCard.astro';
import ChequeoCard from '../../components/ChequeoCard.astro';
import CompartirBar from '../../components/CompartirBar.astro';
import { indexar, porFechaDesc, publicados } from '../../lib/contenido';
import { etiqueta, recortar } from '../../lib/formato';
import { urlDe } from '../../lib/permalinks';
import { ruta } from '../../lib/ruta';

export const getStaticPaths = (async () => {
  const temas = await publicados('temas');
  return temas.map((t) => ({ params: { slug: t.id }, props: { tema: t } }));
}) satisfies GetStaticPaths;

const { tema } = Astro.props;
const id = tema.id;
const alcanza = (t: string) => t === id || t.startsWith(`${id}/`);

const [temas, politicos, declaraciones, giros, promesas, chequeos, eventos] = await Promise.all([
  publicados('temas'),
  publicados('politicos'),
  publicados('declaraciones'),
  publicados('giros'),
  publicados('promesas'),
  publicados('chequeos'),
  publicados('eventos'),
]);

const mapaTemas = indexar(temas);
const mapaPoliticos = indexar(politicos);
const declaracionesPorId = indexar(declaraciones);
const padre = tema.data.padre ? mapaTemas.get(tema.data.padre.id) : undefined;
const hijos = temas.filter((t) => t.data.padre?.id === id).sort((a, b) => a.data.nombre.localeCompare(b.data.nombre, 'es'));

const misDeclaraciones = porFechaDesc(declaraciones.filter((d) => alcanza(d.data.tema.id)));
const misGiros = giros.filter((g) => alcanza(g.data.tema.id));
const misPromesas = promesas.filter((p) => alcanza(p.data.tema.id));
const misChequeos = porFechaDesc(chequeos.filter((c) => alcanza(c.data.tema.id)));
const misEventos = eventos.filter((e) => e.data.temas.some((t) => alcanza(t.id)));

const nombreTema = (t: string) => ({ id: t, nombre: mapaTemas.get(t)?.data.nombre ?? t });
const nombrePolitico = (p: string) => mapaPoliticos.get(p)?.data.nombre_corto ?? p;

const items: ItemTimeline[] = misDeclaraciones.map((d) => ({
  fecha: d.data.fecha,
  titulo: `${nombrePolitico(d.data.politico.id)}: ${d.data.resumen}`,
  href: urlDe('declaraciones', d.id),
  tema: nombreTema(d.data.tema.id),
  resumen: recortar(d.data.cita, 180),
  etiquetas: [{ texto: etiqueta(d.data.contexto) }],
}));

// Por político, para que se vea la cobertura desigual entre personas en vez de esconderla.
const porPolitico = politicos
  .map((p) => ({
    politico: p,
    declaraciones: misDeclaraciones.filter((d) => d.data.politico.id === p.id).length,
    giros: misGiros.filter((g) => g.data.politico.id === p.id).length,
    promesas: misPromesas.filter((x) => x.data.politico.id === p.id).length,
    chequeos: misChequeos.filter((c) => c.data.politico.id === p.id).length,
  }))
  .sort((a, b) => a.politico.data.nombre_corto.localeCompare(b.politico.data.nombre_corto, 'es'));
const totalTema = misDeclaraciones.length + misGiros.length + misPromesas.length + misChequeos.length;
---

<Base titulo={tema.data.nombre} descripcion={tema.data.descripcion}>
  <h1>{tema.data.nombre}</h1>
  <p class="chico">
    {padre && (
      <>
        Subtema de <a href={ruta(`/temas/${padre.id}/`)}>{padre.data.nombre}</a> ·{' '}
      </>
    )}
    <a href={ruta('/temas/')}>Todos los temas</a>
  </p>
  <p class="prosa">{tema.data.descripcion}</p>

  {
    hijos.length > 0 && (
      <nav aria-label="Subtemas">
        <ul class="subnav">
          {hijos.map((h) => (
            <li>
              <a href={ruta(`/temas/${h.id}/`)}>{h.data.nombre}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <details>
    <summary>Alias que disparan este tema ({tema.data.alias.length})</summary>
    <p class="chico">{tema.data.alias.join(' · ')}</p>
    <p class="muy-chico">
      Los alias se usan para etiquetar notas del corpus sin costo de modelo. Si falta uno, es una corrección válida.
    </p>
  </details>

  <CompartirBar titulo={`${tema.data.nombre} en La Casta`} />

  <h2>Cobertura por político</h2>
  <p class="chico">
    Esta tabla está para que la cobertura desigual se vea en vez de pasar inadvertida: un cero no dice que la persona no
    haya hablado del tema, dice que todavía no lo investigamos.
  </p>
  <div class="tabla-scroll">
    <table>
      <caption class="visualmente-oculto">Registros publicados de este tema por político</caption>
      <thead>
        <tr>
          <th scope="col">Político</th>
          <th scope="col">Declaraciones</th>
          <th scope="col">Giros</th>
          <th scope="col">Promesas</th>
          <th scope="col">Chequeos</th>
        </tr>
      </thead>
      <tbody>
        {
          porPolitico.map((f) => (
            <tr>
              <th scope="row">
                <a href={ruta(`/politicos/${f.politico.id}/`)}>{f.politico.data.nombre_corto}</a>
              </th>
              <td>{f.declaraciones}</td>
              <td>{f.giros}</td>
              <td>{f.promesas}</td>
              <td>{f.chequeos}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {
    totalTema === 0 && (
      <p class="vacio">
        Todavía no hay registros publicados sobre este tema. La taxonomía existe antes que el contenido a propósito: así
        se ve qué falta investigar.
      </p>
    )
  }

  {
    misDeclaraciones.length > 0 && (
      <section class="seccion" id="declaraciones">
        <h2>
          Declaraciones <span class="n">({misDeclaraciones.length})</span>
        </h2>
        <Timeline items={items} id="tl-tema" />
      </section>
    )
  }

  {
    misGiros.length > 0 && (
      <section class="seccion" id="giros">
        <h2>
          Giros <span class="n">({misGiros.length})</span>
        </h2>
        {misGiros.map((g) => {
          const antes = declaracionesPorId.get(g.data.declaracion_antes.id);
          const despues = declaracionesPorId.get(g.data.declaracion_despues.id);
          return antes && despues ? <GiroCard giro={g} antes={antes} despues={despues} tema={nombreTema(g.data.tema.id)} /> : null;
        })}
      </section>
    )
  }

  {
    misPromesas.length > 0 && (
      <section class="seccion" id="promesas">
        <h2>
          Promesas <span class="n">({misPromesas.length})</span>
        </h2>
        {misPromesas.map((p) => (
          <PromesaCard promesa={p} tema={nombreTema(p.data.tema.id)} />
        ))}
      </section>
    )
  }

  {
    misChequeos.length > 0 && (
      <section class="seccion" id="chequeos">
        <h2>
          Chequeos <span class="n">({misChequeos.length})</span>
        </h2>
        {misChequeos.map((c) => (
          <ChequeoCard chequeo={c} tema={nombreTema(c.data.tema.id)} />
        ))}
      </section>
    )
  }

  {
    misEventos.length > 0 && (
      <section class="seccion" id="eventos">
        <h2>
          Eventos relacionados <span class="n">({misEventos.length})</span>
        </h2>
        <ul>
          {misEventos.map((e) => (
            <li>
              <a href={ruta(`/eventos/${e.id}/`)}>{e.data.nombre}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
