---
import Base from '../layouts/Base.astro';
import EstadoActual from '../components/EstadoActual.astro';
import GiroCard from '../components/GiroCard.astro';
import ChequeoCard from '../components/ChequeoCard.astro';
import { dePolitico, indexar, porFechaDesc, presidentes, publicados, probables } from '../lib/contenido';

const presis = await presidentes();

const [declaraciones, giros, promesas, chequeos, casos, temas] = await Promise.all([
  publicados('declaraciones'),
  publicados('giros'),
  publicados('promesas'),
  publicados('chequeos'),
  publicados('casos'),
  publicados('temas'),
]);
const mapaTemas = indexar(temas);
const declaracionesPorId = indexar(declaraciones);

const conteos = presis.map((p) => ({
  politico: p,
  declaraciones: dePolitico(declaraciones, p.id).length,
  giros: dePolitico(giros, p.id).length,
  promesas: dePolitico(promesas, p.id).length,
  chequeos: dePolitico(chequeos, p.id).length,
  casos: casos.filter((c) => c.data.involucrados.some((i) => i.politico.id === p.id)).length,
}));

// Últimos giros y chequeos publicados; si no hay, se dice.
// Un giro no tiene fecha propia: se ordena por la fecha de la declaración posterior.
const ultimosGiros = giros
  .filter((g) => declaracionesPorId.has(g.data.declaracion_despues.id) && declaracionesPorId.has(g.data.declaracion_antes.id))
  .sort((a, b) =>
    (declaracionesPorId.get(b.data.declaracion_despues.id)?.data.fecha ?? '').localeCompare(
      declaracionesPorId.get(a.data.declaracion_despues.id)?.data.fecha ?? '',
    ),
  )
  .slice(0, 3);
const ultimosChequeos = porFechaDesc(chequeos).slice(0, 3);

const probablesTotales = (
  await Promise.all(
    (['declaraciones', 'giros', 'promesas', 'chequeos', 'casos', 'intervenciones'] as const).map((c) => probables(c)),
  )
).reduce((a, l) => a + l.length, 0);

const totalRegistros = declaraciones.length + giros.length + promesas.length + chequeos.length + casos.length;
const temaDe = (id: string) => {
  const t = mapaTemas.get(id);
  return t ? { id: t.id, nombre: t.data.nombre } : undefined;
};
---

<Base
  titulo="La Casta"
  ruta="/"
  descripcion="Registro verificable de lo que dijeron, prometieron, hicieron y declararon los representantes uruguayos: presidentes, senadores y diputados desde 2000. Cada afirmación con fuente."
>
  <h1>Lo que dijeron, lo que prometieron y lo que declararon</h1>
  <p class="entrada">
    La Casta es una herramienta de memoria: registra lo que los representantes uruguayos dijeron, prometieron, hicieron y declararon, para que nadie tenga que confiar en su recuerdo. Cubre presidentes, senadores y diputados desde 2000, y se extiende hacia atrás hasta donde las fuentes permitan. Por cada persona: declaraciones y sus giros en el
    tiempo, promesas de campaña contra gestión, chequeos de datos con fuente oficial, casos judiciales con su estado
    explícito y patrimonio declarado ante la JUTEP. Cada afirmación tiene una fuente citable con enlace al original y a
    su copia archivada; cuando es una conclusión propia, la cadena de razonamiento está a la vista.
  </p>

  <div class="aviso" role="note">
    <p>
      <strong>Este sitio lo produce una IA (Claude) supervisada por un humano.</strong> Las instrucciones que recibe
      están publicadas palabra por palabra, y cada registro guarda qué agente lo escribió, con qué prompt y en qué
      corrida. Lo que se garantiza no es una IA neutral, sino un proceso verificable: reglas públicas, fuentes abiertas,
      correcciones y derecho de réplica.
    </p>
    <p class="chico">
      Ver <a href="/sobre/">para qué existe esto y qué significa «casta» acá</a> ·{' '}
      <a href="/metodologia/">cómo se produce y se verifica cada registro</a>
    </p>
  </div>

  <h2>Empezamos por los presidentes desde 2000</h2>
  {
    conteos.length === 0 ? (
      <p class="vacio">Todavía no hay políticos publicados.</p>
    ) : (
      <div class="grilla">
        {conteos.map((c) => (
          <article class="tarjeta">
            <h3>
              <a href={`/politicos/${c.politico.id}/`}>{c.politico.data.nombre_corto}</a>
            </h3>
            <p class="chico">{c.politico.data.partido}</p>
            <EstadoActual politico={c.politico} compacto />
            <ul class="conteos">
              <li>
                <a href={`/politicos/${c.politico.id}/#declaraciones`}>{c.declaraciones} declaraciones</a>
              </li>
              <li>
                <a href={`/politicos/${c.politico.id}/#giros`}>{c.giros} giros</a>
              </li>
              <li>
                <a href={`/politicos/${c.politico.id}/#promesas`}>{c.promesas} promesas</a>
              </li>
              <li>
                <a href={`/politicos/${c.politico.id}/#veracimetro`}>{c.chequeos} chequeos</a>
              </li>
              <li>
                <a href={`/politicos/${c.politico.id}/#casos`}>{c.casos} casos</a>
              </li>
            </ul>
          </article>
        ))}
      </div>
    )
  }

  <h2>Últimos giros</h2>
  {
    ultimosGiros.length === 0 ? (
      <p class="vacio">
        Todavía no hay giros publicados. Un giro compara dos declaraciones del mismo político sobre el mismo tema y las
        califica por cambio (sin cambio, parcial, total) y por explicación (reconocida, justificada por contexto, sin
        explicación). También se publican los «sin cambio»: la consistencia también es información.
      </p>
    ) : (
      ultimosGiros.map((g) => (
        <GiroCard
          giro={g}
          antes={declaracionesPorId.get(g.data.declaracion_antes.id)!}
          despues={declaracionesPorId.get(g.data.declaracion_despues.id)!}
          tema={temaDe(g.data.tema.id)}
        />
      ))
    )
  }

  <h2>Últimos chequeos</h2>
  {
    ultimosChequeos.length === 0 ? (
      <p class="vacio">
        Todavía no hay chequeos publicados. El Veracímetro chequea datos concretos (una cifra, una fecha, un hecho),
        nunca opiniones: «verdadero» y «falso» exigen al menos un documento oficial; con prensa sola solo se puede
        calificar «discutible».
      </p>
    ) : (
      ultimosChequeos.map((c) => <ChequeoCard chequeo={c} tema={temaDe(c.data.tema.id)} />)
    )
  }

  <h2>Estado del sitio</h2>
  <p>
    Hay <strong>{totalRegistros}</strong> {totalRegistros === 1 ? 'registro publicado' : 'registros publicados'} y{' '}
    <strong>{probablesTotales}</strong> en estado probable. Un registro «probable» no cumple todavía todas las reglas
    (le falta una segunda fuente de otro grupo de medios, una etapa judicial o una aprobación humana): se puede leer en{' '}
    <a href="/probable/">/probable/</a>, con banner permanente y excluido de los buscadores.
  </p>
  <p class="chico">
    Todo el contenido y todo el código están en un repositorio público. Los datos se exportan en JSON en{' '}
    <a href="/datos/">/datos/</a>. Si algo está mal, se corrige y la corrección queda registrada en{' '}
    <a href="/correcciones/">/correcciones/</a>.
  </p>
</Base>

<style>
  .entrada {
    font-size: var(--t-md);
    max-width: var(--ancho-prosa);
  }
  .conteos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-1) var(--e-3);
    font-size: var(--t-sm);
  }
</style>
