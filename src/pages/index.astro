---
import Base from '../layouts/Base.astro';
import EstadoActual from '../components/EstadoActual.astro';
import GiroCard from '../components/GiroCard.astro';
import ChequeoCard from '../components/ChequeoCard.astro';
import { dePolitico, indexar, porFechaDesc, presidentes, publicados, probables } from '../lib/contenido';
import { ruta } from '../lib/ruta';

const presis = await presidentes();

const [declaraciones, giros, promesas, chequeos, casos, temas] = await Promise.all([
  publicados('declaraciones'),
  publicados('giros'),
  publicados('promesas'),
  publicados('chequeos'),
  publicados('casos'),
  publicados('temas'),
]);
const mapaTemas = indexar(temas);
const declaracionesPorId = indexar(declaraciones);

const conteos = presis.map((p) => ({
  politico: p,
  declaraciones: dePolitico(declaraciones, p.id).length,
  giros: dePolitico(giros, p.id).length,
  promesas: dePolitico(promesas, p.id).length,
  chequeos: dePolitico(chequeos, p.id).length,
  casos: casos.filter((c) => c.data.involucrados.some((i) => i.politico.id === p.id)).length,
}));

// Últimos giros y chequeos publicados; si no hay, se dice.
// Un giro no tiene fecha propia: se ordena por la fecha de la declaración posterior.
const ultimosGiros = giros
  .filter((g) => declaracionesPorId.has(g.data.declaracion_despues.id) && declaracionesPorId.has(g.data.declaracion_antes.id))
  .sort((a, b) =>
    (declaracionesPorId.get(b.data.declaracion_despues.id)?.data.fecha ?? '').localeCompare(
      declaracionesPorId.get(a.data.declaracion_despues.id)?.data.fecha ?? '',
    ),
  )
  .slice(0, 3);
const ultimosChequeos = porFechaDesc(chequeos).slice(0, 3);

const probablesTotales = (
  await Promise.all(
    (['declaraciones', 'giros', 'promesas', 'chequeos', 'casos', 'intervenciones'] as const).map((c) => probables(c)),
  )
).reduce((a, l) => a + l.length, 0);

const totalRegistros = declaraciones.length + giros.length + promesas.length + chequeos.length + casos.length;
const temaDe = (id: string) => {
  const t = mapaTemas.get(id);
  return t ? { id: t.id, nombre: t.data.nombre } : undefined;
};
---

<Base
  titulo="La Casta"
  ruta="/"
  descripcion="Registro verificable de lo que dijeron, prometieron, hicieron y declararon los representantes uruguayos: presidentes, senadores y diputados desde 2000. Cada afirmación con fuente."
>
  <div class="definicion">
    <h1>casta</h1>
    <p class="gramatical">sustantivo femenino · uso político</p>
    <p class="acepcion">
      Quienes ejercen poder público y viven en condiciones muy distintas a las de la gente que representan.
    </p>
    <p class="chico">
      Es una descripción del lugar que ocupa una persona cuando decide por otros, no un guiño a ninguna corriente
      política. El mismo criterio se aplica a todos los partidos y a todas las personas.{' '}
      <a href={ruta('/sobre/')}>Por qué el sitio se llama así</a>.
    </p>
  </div>

  <h2>Qué es este sitio</h2>
  <p class="entrada">
    La Casta es un registro público de lo que los representantes uruguayos dijeron, prometieron, hicieron y declararon.
    Cada afirmación tiene una fuente citable, con enlace al original y a su copia archivada; cuando es una conclusión
    propia, la cadena de razonamiento queda a la vista. Cubre presidentes, senadores y diputados desde 2000, y se
    extiende hacia atrás hasta donde las fuentes permitan documentar.
  </p>

  <h2>Por qué existe y qué se propone</h2>
  <p class="parrafo">
    Existe para que nadie tenga que confiar en su memoria. Lo que un candidato prometió en campaña queda al lado de lo
    que hizo en el cargo; lo que afirmó hace quince años, al lado de lo que afirma hoy. Sin ese registro, la discusión
    política se apoya en el recuerdo de cada uno, y el recuerdo es corto y conveniente.
  </p>
  <p class="parrafo">
    El objetivo es que lo usen personas de cualquier partido, y que lo usen porque cada dato se puede comprobar, no
    porque el sitio les resulte afín. Por eso la primera regla del proyecto, escrita y pública, está por encima de
    cualquier otra instrucción, incluidas las de quien mantiene el repositorio: el mismo criterio de búsqueda y de
    calificación se aplica a todos. Documentar lo que alguien dijo e hizo no es una acusación; es lo que hace falta para
    evaluarlo.
  </p>

  <h2>Qué vas a encontrar por cada político</h2>
  <ul class="que-hay">
    <li>
      <strong>Declaraciones y sus giros.</strong> Qué dijo, cuándo y en qué contexto, y cómo cambió con el tiempo: cada
      giro se califica por cambio (sin cambio, parcial, total) y por cómo lo explicó.
    </li>
    <li>
      <strong>Promesas contra gestión.</strong> Lo que prometió en campaña frente a lo que hizo en el cargo, en la
      escala cumplida / en proceso adelantada / en proceso demorada / incumplida.
    </li>
    <li>
      <strong>Veracímetro.</strong> Chequeo de datos concretos, nunca de opiniones: «verdadero» y «falso» exigen un
      documento oficial; con prensa sola, lo máximo es «discutible».
    </li>
    <li>
      <strong>Casos con estado judicial.</strong> Solo lo que ya es público, con la etapa y su fecha siempre a la vista.
      Una denuncia no es una condena, y el sitio lo dice en cada caso.
    </li>
    <li><strong>Patrimonio declarado.</strong> Lo que declaró ante la JUTEP, con su evolución entre declaraciones.</li>
    <li>
      <strong>Sustancia del discurso.</strong> Cuánto de lo que dice son hechos y propuestas y cuánto es retórica,
      ataque o evasión, clasificado a ciegas por dos modelos y con el acuerdo entre ambos publicado.
    </li>
    <li><strong>Referentes.</strong> A quién cita como autoridad, a quién reivindica y a quién critica.</li>
  </ul>

  <h2>Por qué lo hace una IA</h2>
  <p class="parrafo">
    Nadie puede buscar muchas fuentes, compararlas y discernir entre ellas a la velocidad a la que salen las noticias
    como lo hace la inteligencia artificial. Mucho menos una sola persona, y mucho menos con los treinta años de
    historia que estamos revisando. Nadie retiene en su memoria el contexto con el que trabaja una IA, que recuerda
    tanto lo de hace veinte años como lo de hace veinte días y encuentra patrones y coincidencias entre historias
    distintas para detectar irregularidades. Eso no la vuelve imparcial:{' '}
    <a href={ruta('/sobre/')}>por qué lo hace una IA y qué no garantiza</a>.
  </p>

  <div class="aviso" role="note">
    <p>
      <strong>Este sitio lo produce una IA (Claude) supervisada por un humano.</strong> Las instrucciones que recibe
      están publicadas palabra por palabra, y cada registro guarda qué agente lo escribió, con qué prompt y en qué
      corrida. Lo que se garantiza no es una IA neutral, sino un proceso verificable: reglas públicas, fuentes abiertas,
      correcciones y derecho de réplica.
    </p>
    <p class="chico">
      Ver <a href={ruta('/sobre/')}>para qué existe esto y qué significa «casta»</a> ·{' '}
      <a href={ruta('/metodologia/')}>cómo se produce y se verifica cada registro</a>
    </p>
  </div>

  <h2 id="empezamos">Por dónde empezamos</h2>
  <p class="parrafo">
    El primer grupo cargado son los presidentes desde 2000. No son el alcance del sitio: son el punto de partida.
    Después siguen los <strong>senadores y diputados desde 2000</strong>, y desde ahí el registro se extiende hacia
    atrás en la historia hasta donde las fuentes permitan documentar. El listado completo, con la línea de tiempo de
    mandatos, está en <a href={ruta('/politicos/')}>políticos</a>.
  </p>
  {
    conteos.length === 0 ? (
      <p class="vacio">Todavía no hay políticos publicados.</p>
    ) : (
      <div class="grilla">
        {conteos.map((c) => (
          <article class="tarjeta">
            <h3>
              <a href={ruta(`/politicos/${c.politico.id}/`)}>{c.politico.data.nombre_corto}</a>
            </h3>
            <p class="chico">{c.politico.data.partido}</p>
            <EstadoActual politico={c.politico} compacto />
            <ul class="conteos">
              <li>
                <a href={ruta(`/politicos/${c.politico.id}/#declaraciones`)}>{c.declaraciones} declaraciones</a>
              </li>
              <li>
                <a href={ruta(`/politicos/${c.politico.id}/#giros`)}>{c.giros} giros</a>
              </li>
              <li>
                <a href={ruta(`/politicos/${c.politico.id}/#promesas`)}>{c.promesas} promesas</a>
              </li>
              <li>
                <a href={ruta(`/politicos/${c.politico.id}/#veracimetro`)}>{c.chequeos} chequeos</a>
              </li>
              <li>
                <a href={ruta(`/politicos/${c.politico.id}/#casos`)}>{c.casos} casos</a>
              </li>
            </ul>
          </article>
        ))}
      </div>
    )
  }

  <h2>Últimos giros</h2>
  {
    ultimosGiros.length === 0 ? (
      <p class="vacio">
        Todavía no hay giros publicados. Un giro compara dos declaraciones del mismo político sobre el mismo tema y las
        califica por cambio (sin cambio, parcial, total) y por explicación (reconocida, justificada por contexto, sin
        explicación). También se publican los «sin cambio»: la consistencia también es información.
      </p>
    ) : (
      ultimosGiros.map((g) => (
        <GiroCard
          giro={g}
          antes={declaracionesPorId.get(g.data.declaracion_antes.id)!}
          despues={declaracionesPorId.get(g.data.declaracion_despues.id)!}
          tema={temaDe(g.data.tema.id)}
        />
      ))
    )
  }

  <h2>Últimos chequeos</h2>
  {
    ultimosChequeos.length === 0 ? (
      <p class="vacio">
        Todavía no hay chequeos publicados. El Veracímetro chequea datos concretos (una cifra, una fecha, un hecho),
        nunca opiniones: «verdadero» y «falso» exigen al menos un documento oficial; con prensa sola solo se puede
        calificar «discutible».
      </p>
    ) : (
      ultimosChequeos.map((c) => <ChequeoCard chequeo={c} tema={temaDe(c.data.tema.id)} />)
    )
  }

  <h2>Estado del sitio</h2>
  <p>
    Hay <strong>{totalRegistros}</strong> {totalRegistros === 1 ? 'registro publicado' : 'registros publicados'} y{' '}
    <strong>{probablesTotales}</strong> en estado probable. Un registro «probable» no cumple todavía todas las reglas
    (le falta una segunda fuente de otro grupo de medios, una etapa judicial o una aprobación humana): se puede leer en{' '}
    <a href={ruta('/probable/')}>/probable/</a>, con banner permanente y excluido de los buscadores.
  </p>
  <p class="chico">
    Todo el contenido y todo el código están en un repositorio público. Los datos se exportan en JSON en{' '}
    <a href={ruta('/datos/')}>/datos/</a>. Si algo está mal, se corrige y la corrección queda registrada en{' '}
    <a href={ruta('/correcciones/')}>/correcciones/</a>.
  </p>
</Base>

<style>
  .entrada {
    font-size: var(--t-md);
    max-width: var(--ancho-prosa);
  }
  /* Entrada de diccionario: lo primero que ve quien llega es qué significa la palabra. */
  .definicion {
    max-width: var(--ancho-prosa);
    border-left: 4px solid var(--acento);
    background: var(--fondo-2);
    border-radius: var(--radio);
    padding: var(--e-4) var(--e-5);
    margin-bottom: var(--e-6);
  }
  .definicion h1 {
    margin: 0;
    font-size: var(--t-2xl);
    font-style: italic;
  }
  .definicion .gramatical {
    margin: 0 0 var(--e-3);
    font-size: var(--t-sm);
    color: var(--texto-2);
  }
  .definicion .acepcion {
    margin: 0 0 var(--e-3);
    font-size: var(--t-md);
  }
  .definicion > :last-child {
    margin-bottom: 0;
  }
  .parrafo,
  .que-hay {
    max-width: var(--ancho-prosa);
  }
  .que-hay {
    padding-left: var(--e-5);
  }
  .que-hay li {
    margin-bottom: var(--e-2);
  }
  .conteos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-1) var(--e-3);
    font-size: var(--t-sm);
  }
</style>
