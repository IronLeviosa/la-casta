---
import Base from '../../layouts/Base.astro';
import EstadoActual from '../../components/EstadoActual.astro';
import BandaMandato from '../../components/BandaMandato.astro';
import { dePolitico, indexar, presidentes, publicados, vicepresidentes } from '../../lib/contenido';
import { ES_PRESIDENTE, ES_VICEPRESIDENTE } from '../../lib/roles';
import { fechaLarga, fechaParcialLarga } from '../../lib/formato';
import { colorDePartido } from '../../lib/partidos';
import { ruta } from '../../lib/ruta';
import { completarFecha } from '../../schemas/base';
import { leerCorridas } from '../../lib/corridas';

const [politicos, referentes, menciones, declaraciones, giros, promesas, chequeos, patrimonio, intervenciones, casos] =
  await Promise.all([
    publicados('politicos'),
    publicados('referentes'),
    publicados('menciones'),
    publicados('declaraciones'),
    publicados('giros'),
    publicados('promesas'),
    publicados('chequeos'),
    publicados('patrimonio'),
    publicados('intervenciones'),
    publicados('casos'),
  ]);

const presis = await presidentes();
const vices = await vicepresidentes();
const mapaReferentes = indexar(referentes);
const porReferente = new Map<string, number>();
for (const m of menciones) {
  const k = m.data.referente?.id ?? m.data.politico_mencionado?.id ?? '';
  if (k) porReferente.set(k, (porReferente.get(k) ?? 0) + 1);
}

/* Los legisladores todavía no están cargados; el estado vacío lo dice en lugar de esconderlo. */
const esPresidente = (cargo: string) => ES_PRESIDENTE.test(cargo);
const esVice = (cargo: string) => ES_VICEPRESIDENTE.test(cargo);
const senadores = politicos.filter((p) => p.data.mandatos.some((m) => /^senador/i.test(m.cargo)));
const diputados = politicos.filter((p) => p.data.mandatos.some((m) => /^(diputad|represent)/i.test(m.cargo)));

// ---------------------------------------------------------------------------
// Línea de tiempo de mandatos presidenciales
//
// Sin JavaScript: la posición de cada banda se calcula en el build y se expresa
// como columnas de una grilla CSS de un mes de ancho cada una. La ficha se
// muestra con :hover y con :focus-within (o sea, también con teclado), y en
// pantallas angostas la línea se apila y las fichas quedan siempre visibles.
// ---------------------------------------------------------------------------

/** Índice de mes desde enero de 2000 (2000-01 → 0, 2000-02 → 1, …). */
function mesIndice(iso: string): number {
  const [a, m] = iso.split('-').map(Number);
  return (a! - 2000) * 12 + (m! - 1);
}

const HOY = new Date().toISOString().slice(0, 10);
const ANIO_INICIO = 2000;

/** Un mandato presidencial ya ubicado en la grilla. */
interface Banda {
  politico: (typeof presis)[number];
  cargo: string;
  desde: string;
  hasta?: string;
  colInicio: number;
  colSpan: number;
  fila: number;
}

function mandatosDe(gente: typeof presis, filtro: (cargo: string) => boolean) {
  return gente
    .flatMap((p) => p.data.mandatos.filter((m) => filtro(m.cargo)).map((m) => ({ politico: p, ...m })))
    .filter((m) => !m.hasta || completarFecha(m.hasta, 'fin') >= `${ANIO_INICIO}-01-01`)
    .sort((a, b) => completarFecha(a.desde, 'inicio').localeCompare(completarFecha(b.desde, 'inicio')));
}

const mandatos = mandatosDe(presis, esPresidente);
const mandatosVice = mandatosDe(vices, esVice);

// Los dos roles comparten el mismo eje: si cada uno calculara su fin, las bandas de arriba y las
// de abajo no quedarian alineadas y comparar un periodo con otro seria enganoso.
const finEje = [HOY, ...mandatos.map((m) => completarFecha(m.hasta ?? HOY, 'fin')), ...mandatosVice.map((m) => completarFecha(m.hasta ?? HOY, 'fin'))]
  .sort()
  .at(-1)!;
const columnas = mesIndice(finEje) + 1;

/* Los mandatos presidenciales no se superponen, pero el reparto en filas no lo
   asume: si dos bandas se pisaran (por un dato nuevo o un error), se verían las
   dos en filas distintas en vez de taparse. */
function aBandas(ms: ReturnType<typeof mandatosDe>): Banda[] {
  const finPorFila: number[] = [];
  return ms.map((m) => {
    // La grilla necesita un mes concreto: una fecha con precisión de año se ubica en su primer
    // mes, y una de fin en el último. La banda queda del largo correcto y la ficha muestra la
    // precisión real, así que la aproximación no se propaga al texto.
    const colInicio = mesIndice(completarFecha(m.desde, 'inicio')) + 1;
    const colFin = mesIndice(completarFecha(m.hasta ?? finEje, 'fin')) + 1;
    const colSpan = Math.max(1, colFin - colInicio);
    let fila = finPorFila.findIndex((fin) => fin <= colInicio);
    if (fila === -1) fila = finPorFila.length;
    finPorFila[fila] = colInicio + colSpan;
    return { politico: m.politico, cargo: m.cargo, desde: m.desde, hasta: m.hasta, colInicio, colSpan, fila: fila + 1 };
  });
}

const bandas: Banda[] = aBandas(mandatos);
const bandasVice: Banda[] = aBandas(mandatosVice);

/** Marcas del eje: cada cinco años desde 2000 hasta el último año representado. */
const anioFin = Number(finEje.slice(0, 4));
const marcas: { anio: number; col: number }[] = [];
for (let a = ANIO_INICIO; a <= anioFin; a += 5) marcas.push({ anio: a, col: mesIndice(`${a}-01-01`) + 1 });

/** Conteos publicados por político. Es un resumen derivado, no una afirmación nueva. */
// Corridas realmente ejecutadas, para distinguir "se investigó y no había" de "no se investigó".
// Sin esa distinción, la ficha de una persona recién cargada muestra ocho ceros y se lee como si el
// sitio hubiera mirado y no hubiera encontrado nada, que es la conclusión opuesta a la verdadera.
const corridas = leerCorridas(politicos.map((p) => p.id));
const investigados = new Set(corridas.map((c) => c.politico));

/**
 * Candidaturas presidenciales agrupadas por eleccion, de la mas reciente a la mas vieja.
 *
 * Se lista el campo entero y no solo a los perdedores: el ganador tambien fue candidato, y sacarlo
 * de la lista dejaria una tabla de derrotados en vez del cuadro de la eleccion. Dentro de cada
 * eleccion el orden es por votos y, cuando no hay votos documentados, por nombre: ordenar por
 * resultado pondria siempre al mismo arriba sin que un dato lo sostenga.
 */
const ES_PRESIDENCIA = /^\s*presidencia de la rep/i;
// Se agrupa por año y no por fecha exacta. Cada candidatura lleva la fecha de la instancia que
// decidió su suerte —primera vuelta para quien quedó ahí, balotaje para quien llegó—, así que
// agrupar por fecha parte una misma elección en dos listas y la hace parecer dos elecciones. El día
// de cada uno se muestra en su propia tarjeta.
const elecciones = new Map<string, { politico: (typeof politicos)[number]; c: any }[]>();
for (const p of politicos) {
  for (const c of p.data.candidaturas ?? []) {
    if (!ES_PRESIDENCIA.test(c.cargo)) continue;
    const anio = c.fecha.slice(0, 4);
    if (!elecciones.has(anio)) elecciones.set(anio, []);
    elecciones.get(anio)!.push({ politico: p, c });
  }
}
const eleccionesOrdenadas = [...elecciones.entries()]
  .sort((a, b) => b[0].localeCompare(a[0]))
  .map(([anio, lista]) => ({
    anio,
    lista: lista.sort((a, b) => (b.c.votos ?? -1) - (a.c.votos ?? -1) || a.politico.data.nombre_corto.localeCompare(b.politico.data.nombre_corto, 'es')),
  }));

function conteos(slug: string) {
  return [
    { n: dePolitico(declaraciones, slug).length, etiqueta: 'declaraciones' },
    { n: dePolitico(giros, slug).length, etiqueta: 'giros' },
    { n: dePolitico(promesas, slug).length, etiqueta: 'promesas' },
    { n: dePolitico(chequeos, slug).length, etiqueta: 'chequeos' },
    { n: dePolitico(patrimonio, slug).length, etiqueta: 'declaraciones de patrimonio' },
    { n: dePolitico(intervenciones, slug).length, etiqueta: 'intervenciones' },
    { n: dePolitico(menciones, slug).length, etiqueta: 'menciones a referentes' },
    { n: casos.filter((c) => c.data.involucrados.some((i) => i.politico.id === slug)).length, etiqueta: 'casos' },
  ];
}

/** Iniciales para el marcador de las personas sin foto de licencia libre. */
const iniciales = (nombre: string) =>
  nombre
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((s) => s[0]!.toUpperCase())
    .join('');

const periodo = (desde: string, hasta?: string) =>
  `${fechaParcialLarga(desde)} – ${hasta ? fechaParcialLarga(hasta) : 'actualidad'}`;
---

<Base
  titulo="Políticos"
  descripcion="Las personas cubiertas por el sitio, agrupadas en presidentes, senadores y diputados, con sus mandatos y su estado actual."
>
  <h1>Políticos</h1>
  <p class="prosa">
    El sitio arranca por los presidentes desde 2000, sigue con senadores y diputados del mismo período, y se extiende
    hacia atrás hasta donde las fuentes permitan. Cada perfil reúne declaraciones, giros, promesas, chequeos, patrimonio
    declarado, referentes y casos, todo con fuente.
  </p>

  <section class="seccion" id="presidentes">
    <h2>Presidentes y vicepresidentes <span class="n">({presis.length + vices.length})</span></h2>
    {
      bandas.length === 0 ? (
        <p class="vacio">Todavía no hay presidentes publicados.</p>
      ) : (
        <>
          <p class="chico">
            Una banda por mandato, de {ANIO_INICIO} a hoy, del color del partido. Arriba del eje van los presidentes
            y abajo los vicepresidentes del mismo período, sobre la misma escala de tiempo. Cada banda lleva escrito el
            partido: el color nunca es el único dato. Pasá el mouse o llegá con el teclado (Tab) a una banda para ver
            su ficha; al hacer clic se abre el perfil. En pantallas angostas la línea se apila y las fichas quedan
            siempre a la vista.
          </p>

          <div class="lt" style={`--lt-columnas: ${columnas}`}>
            <p class="lt-rotulo">Presidentes</p>
            <ol class="lt-bandas">
              {bandas.map((b) => <BandaMandato b={b} conteos={conteos(b.politico.id)} periodo={periodo(b.desde, b.hasta)} investigado={investigados.has(b.politico.id)} />)}
            </ol>
            <ul class="lt-eje">
              {marcas.map((m) => (
                <li class="lt-marca" style={`--col: ${m.col}`}>
                  {m.anio}
                </li>
              ))}
              <li class="lt-marca lt-marca-fin" style={`--col: ${columnas}`}>
                hoy
              </li>
            </ul>
            <p class="lt-rotulo">Vicepresidentes</p>
            {
              bandasVice.length === 0 ? (
                <p class="vacio chico">
                  Todavía no hay vicepresidentes publicados. Son los siguientes en investigarse: la banda de abajo
                  queda vacía a propósito, para que se vea qué falta y no para dar a entender que el período no tuvo
                  vicepresidente.
                </p>
              ) : (
                <ol class="lt-bandas lt-bandas-vice">
                  {bandasVice.map((b) => (
                    <BandaMandato b={b} conteos={conteos(b.politico.id)} periodo={periodo(b.desde, b.hasta)} investigado={investigados.has(b.politico.id)} />
                  ))}
                </ol>
              )
            }
            {
              bandasVice.length > 0 && (
                <p class="muy-chico lt-nota">
                  Entre el 15 de febrero y el 1º de marzo de cada cambio de gobierno la banda de
                  abajo tiene un hueco de dos semanas, y no es un error de fecha. La nueva
                  Legislatura jura el 15 de febrero y el presidente y el vicepresidente asumen recién
                  el 1º de marzo; en el medio la vicepresidencia queda vacante y la Asamblea General
                  la preside el senador que encabeza la lista más votada. Así lo describe Búsqueda
                  para la transición de 2025:{' '}
                  <q>
                    Desde el 15 de febrero y hasta el 1º de marzo, el senador Alejandro Sánchez será
                    el presidente del Senado y de la Asamblea General, debido a que encabeza la lista
                    más votada (la 609, del Movimiento de Participación Popular) del partido más
                    apoyado, Frente Amplio (FA)
                  </q>{' '}
                  (<a href="https://www.busqueda.com.uy/politica/la-asuncion-del-nuevo-parlamento-los-detalles-del-inicio-la-legislatura-n5395889" rel="external">Búsqueda, 15 de febrero de 2025</a>).
                  Quién ejerció ese rol en cada transición anterior no está documentado acá todavía.
                </p>
              )
            }
          </div>
        </>
      )
    }
  </section>

  <section class="seccion" id="candidatos">
    <h2>
      Candidatos a la presidencia <span class="n">({eleccionesOrdenadas.reduce((n, e) => n + e.lista.length, 0)})</span>
    </h2>
    <p class="chico">
      El cuadro completo de cada elección, ganador incluido: sacar a quien ganó dejaría una lista de
      derrotados en vez de la elección. Presentarse no es haber gobernado, así que una candidatura no
      cuenta como mandato y no aparece en la línea de tiempo de arriba.
    </p>
    {
      eleccionesOrdenadas.length === 0 ? (
        <p class="vacio">Todavía no hay candidaturas cargadas.</p>
      ) : (
        eleccionesOrdenadas.map((e) => (
          <div class="eleccion">
            <h3>Elección nacional de {e.anio}</h3>
            <div class="grilla">
              {e.lista.map(({ politico: p, c }) => (
                <article class="tarjeta">
                  <h4>
                    <a href={ruta(`/politicos/${p.id}/`)}>{p.data.nombre_corto}</a>
                  </h4>
                  <p class="chico">{c.lema}</p>
                  <p class="chico">
                    <strong>{c.resultado === 'electo' ? 'Electo' : 'No electo'}</strong>
                    {c.votos !== undefined && <> · {c.votos.toLocaleString('es-UY')} votos</>} ·{' '}
                    <time datetime={c.fecha}>{fechaLarga(c.fecha)}</time>
                  </p>
                  {c.detalle && <p class="muy-chico">{c.detalle}</p>}
                </article>
              ))}
            </div>
          </div>
        ))
      )
    }
  </section>

  <section class="seccion" id="senadores">
    <h2>Senadores <span class="n">({senadores.length})</span></h2>
    {
      senadores.length === 0 ? (
        <p class="vacio">Todavía no hay senadores cargados; siguen después de los presidentes.</p>
      ) : (
        <div class="grilla">
          {senadores.map((p) => (
            <article class="tarjeta">
              <h3>
                <a href={ruta(`/politicos/${p.id}/`)}>{p.data.nombre_corto}</a>
              </h3>
              <p class="chico">{p.data.partido}</p>
              <EstadoActual politico={p} compacto />
            </article>
          ))}
        </div>
      )
    }
  </section>

  <section class="seccion" id="diputados">
    <h2>Diputados <span class="n">({diputados.length})</span></h2>
    {
      diputados.length === 0 ? (
        <p class="vacio">Todavía no hay diputados cargados; siguen después de los presidentes.</p>
      ) : (
        <div class="grilla">
          {diputados.map((p) => (
            <article class="tarjeta">
              <h3>
                <a href={ruta(`/politicos/${p.id}/`)}>{p.data.nombre_corto}</a>
              </h3>
              <p class="chico">{p.data.partido}</p>
              <EstadoActual politico={p} compacto />
            </article>
          ))}
        </div>
      )
    }
  </section>

  <section class="seccion" id="referentes">
    <h2>Referentes citados <span class="n">({mapaReferentes.size})</span></h2>
    <p class="chico">
      Personas, organizaciones, obras y corrientes que los políticos citan como autoridad, reivindican o critican.
    </p>
    {
      mapaReferentes.size === 0 ? (
        <p class="vacio">Todavía no hay referentes publicados.</p>
      ) : (
        <ul>
          {[...mapaReferentes.values()].map((r) => (
            <li>
              <strong>{r.data.nombre}</strong> <span class="chico">· {r.data.descripcion}</span>{' '}
              <span class="muy-chico">({porReferente.get(r.id) ?? 0} menciones)</span>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>

<style>
  /* Contenedor: es el bloque posicionado, así las fichas se ubican respecto de
     él y no de cada banda (que sería un contenedor angosto y las recortaría). */
  .lt {
    position: relative;
    margin: var(--e-4) 0 var(--e-6);
  }

  .lt-bandas,
  .lt-eje {
    display: grid;
    /* Una columna por mes: así la posición de cada banda es exacta sin JS.
       El column-gap va en cero a propósito; con 300 columnas cualquier gap
       horizontal sumaría más ancho que la propia línea de tiempo. */
    grid-template-columns: repeat(var(--lt-columnas), minmax(0, 1fr));
    column-gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lt-nota {
    margin-top: var(--e-3);
    color: var(--texto-2);
    max-width: 70ch;
  }

  .lt-rotulo {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-tenue);
    margin: 0 0 var(--e-1);
  }

  /* El eje queda entre las dos bandas: separa presidentes de vicepresidentes y les da a las dos
     la misma referencia temporal, sin repetir los anios dos veces. */
  .lt-eje {
    margin-bottom: var(--e-3);
  }

  .lt-bandas {
    grid-auto-rows: 3.5rem;
    row-gap: var(--e-1);
  }

  .lt-banda {
    grid-column: var(--col) / span var(--span);
    grid-row: var(--fila);
    min-width: 0;
  }

  .lt-enlace {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    padding: var(--e-1) var(--e-2);
    background: var(--color);
    color: #fff;
    border-radius: var(--radio);
    text-decoration: none;
    overflow: hidden;
    /* Los mandatos son contiguos (uno termina el día que empieza el otro):
       este margen deja ver la costura entre bandas. */
    margin-right: 2px;
  }
  .lt-enlace:visited {
    color: #fff;
  }
  .lt-enlace:hover,
  .lt-enlace:focus-visible {
    outline-offset: 2px;
    box-shadow: inset 0 0 0 2px #fff;
  }
  .lt-nombre {
    font-weight: 650;
    font-size: var(--t-sm);
    line-height: 1.15;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .lt-partido,
  .lt-periodo {
    font-size: var(--t-xs);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .lt-partido {
    opacity: 0.95;
  }
  .lt-periodo {
    opacity: 0.85;
  }

  /* Eje de años. Decorativo respecto del contenido: los períodos exactos están
     escritos en cada ficha, no solo en la escala. */
  .lt-eje {
    margin-top: var(--e-2);
    border-top: 1px solid var(--borde);
    font-size: var(--t-xs);
    color: var(--texto-3);
  }
  .lt-marca {
    grid-column: var(--col);
    grid-row: 1;
    border-left: 1px solid var(--borde);
    padding-left: 0.2em;
    white-space: nowrap;
  }
  .lt-marca-fin {
    justify-self: end;
    border-left: 0;
    border-right: 1px solid var(--borde);
    padding: 0 0.2em 0 0;
  }

  /* Ficha: oculta hasta que la banda recibe mouse o foco. Ocupa el ancho del
     contenedor, así nunca se sale de la pantalla. */
  .lt-ficha {
    position: absolute;
    top: calc(100% + var(--e-2));
    left: 0;
    right: 0;
    z-index: 20;
    background: var(--fondo-2);
    border: 1px solid var(--borde-2);
    border-left: 6px solid var(--color);
    border-radius: var(--radio);
    padding: var(--e-4);
    box-shadow: 0 6px 24px rgb(0 0 0 / 18%);
    opacity: 0;
    visibility: hidden;
  }
  .lt-banda:hover .lt-ficha,
  .lt-banda:focus-within .lt-ficha {
    opacity: 1;
    visibility: visible;
  }
  .lt-ficha-cab {
    display: flex;
    gap: var(--e-4);
    align-items: flex-start;
  }
  .lt-ficha-cab > div > :last-child {
    margin-bottom: 0;
  }
  .lt-ficha-nombre {
    font-weight: 650;
    margin: 0 0 var(--e-1);
  }
  .lt-foto {
    flex: none;
    width: 5rem;
    height: 6.25rem;
    object-fit: cover;
    object-position: top center;
    border-radius: var(--radio);
    background: var(--fondo-3);
  }
  .lt-foto-vacia {
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 650;
    font-size: var(--t-lg);
    color: var(--texto-3);
    border: 1px dashed var(--borde-2);
  }
  .lt-conteos {
    list-style: none;
    padding: 0;
    margin: var(--e-3) 0 var(--e-2);
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-1) var(--e-3);
    font-size: var(--t-sm);
    color: var(--texto-2);
  }
  .lt-credito {
    margin: 0;
  }

  /* Pantallas angostas: la línea se apila en vertical y las fichas quedan
     siempre visibles, porque en táctil no hay hover. */
  @media (max-width: 52rem) {
    .lt-bandas {
      display: flex;
      flex-direction: column;
      gap: var(--e-4);
    }
    .lt-banda {
      display: block;
    }
    .lt-enlace {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--e-1) var(--e-3);
      align-items: baseline;
      height: auto;
      padding: var(--e-2) var(--e-3);
      border-radius: var(--radio) var(--radio) 0 0;
      margin-right: 0;
    }
    .lt-nombre,
    .lt-partido,
    .lt-periodo {
      white-space: normal;
    }
    .lt-ficha {
      position: static;
      opacity: 1;
      visibility: visible;
      box-shadow: none;
      border-radius: 0 0 var(--radio) var(--radio);
      border-top: 0;
    }
    .lt-eje {
      display: none;
    }
  }
</style>
