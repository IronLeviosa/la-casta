---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import EstadoActual from '../../../components/EstadoActual.astro';
import Timeline, { type ItemTimeline } from '../../../components/Timeline.astro';
import GiroCard from '../../../components/GiroCard.astro';
import VetoCard from '../../../components/VetoCard.astro';
import MencionesDe from '../../../components/MencionesDe.astro';
import PromesaCard from '../../../components/PromesaCard.astro';
import Veracimetro from '../../../components/Veracimetro.astro';
import ChequeoCard from '../../../components/ChequeoCard.astro';
import CasoCard from '../../../components/CasoCard.astro';
import PatrimonioChart from '../../../components/PatrimonioChart.astro';
import Sustancia from '../../../components/Sustancia.astro';
import CompartirBar from '../../../components/CompartirBar.astro';
import Cobertura from '../../../components/Cobertura.astro';
import Procedencia from '../../../components/Procedencia.astro';
import Cita from '../../../components/Cita.astro';
import { dePolitico, indexar, porFechaDesc, probables, publicados } from '../../../lib/contenido';
import { etiqueta, fechaLarga, fechaParcialLarga, plural, recortar } from '../../../lib/formato';
import { completarFecha } from '../../../schemas/base';
import { urlDe } from '../../../lib/permalinks';
import { resumirSustancia, type ChequeoMinimo, type IntervencionMinima } from '../../../lib/sustancia';
import { ruta } from '../../../lib/ruta';
import { fechaInvestigacion, leerCorridas } from '../../../lib/corridas';

export const getStaticPaths = (async () => {
  const politicos = await publicados('politicos');
  return politicos.map((p) => ({ params: { slug: p.id }, props: { politico: p } }));
}) satisfies GetStaticPaths;

const { politico } = Astro.props;
const slug = politico.id;

const [
  declaraciones,
  giros,
  vetos,
  promesas,
  chequeos,
  casos,
  intervenciones,
  patrimonio,
  menciones,
  referentes,
  temas,
] = await Promise.all([
  publicados('declaraciones'),
  publicados('giros'),
  publicados('vetos'),
  publicados('promesas'),
  publicados('chequeos'),
  publicados('casos'),
  publicados('intervenciones'),
  publicados('patrimonio'),
  publicados('menciones'),
  publicados('referentes'),
  publicados('temas'),
]);

const misDeclaraciones = porFechaDesc(dePolitico(declaraciones, slug));
const misGiros = dePolitico(giros, slug);
const misVetos = porFechaDesc(dePolitico(vetos, slug));
const misPromesas = dePolitico(promesas, slug);
const misChequeos = porFechaDesc(dePolitico(chequeos, slug));
const misCasos = casos.filter((c) => c.data.involucrados.some((i) => i.politico.id === slug));
const misIntervenciones = porFechaDesc(dePolitico(intervenciones, slug));
const miPatrimonio = dePolitico(patrimonio, slug);
const misMenciones = porFechaDesc(dePolitico(menciones, slug));

const declaracionesPorId = indexar(declaraciones);
const mapaTemas = new Map(temas.map((t) => [t.id, t.data.nombre]));
const mapaReferentes = indexar(referentes);
const todosLosPoliticos = await publicados('politicos');
const nombresPoliticos = new Map(todosLosPoliticos.map((p) => [p.id, p.data.nombre_corto]));
const mapaPoliticos = indexar(todosLosPoliticos);
const temaDe = (id: string) => (mapaTemas.has(id) ? { id, nombre: mapaTemas.get(id)! } : undefined);

// Registros del mismo político en tier probable: se cuentan y se enlazan, no se muestran acá.
const probablesDe = await Promise.all(
  (['declaraciones', 'giros', 'promesas', 'chequeos', 'casos', 'intervenciones'] as const).map((c) => probables(c)),
);
const nProbables = probablesDe.reduce((total, lista) => {
  return (
    total +
    lista.filter((e) => {
      const d = e.data as { politico?: { id: string }; involucrados?: { politico: { id: string } }[] };
      return d.politico?.id === slug || d.involucrados?.some((i) => i.politico.id === slug);
    }).length
  );
}, 0);

// Índice de sustancia: se calcula acá y el componente decide si hay muestra.
const intervencionesMin: IntervencionMinima[] = misIntervenciones.map((i) => ({
  id: i.id,
  fecha: i.data.fecha,
  formato: i.data.formato,
  palabras: i.data.palabras,
  segmentos: i.data.segmentos,
  kappa: i.data.kappa,
  chequeo_exhaustivo: i.data.chequeo_exhaustivo,
}));
const chequeosMin: ChequeoMinimo[] = misChequeos.map((c) => ({
  calificacion: c.data.calificacion,
  exhaustivo: c.data.exhaustivo,
  declaracion: c.data.declaracion.id,
}));
const resumen = resumirSustancia(intervencionesMin, chequeosMin);

const itemsTimeline: ItemTimeline[] = misDeclaraciones.map((d) => ({
  fecha: d.data.fecha,
  titulo: d.data.resumen,
  href: urlDe('declaraciones', d.id),
  tema: temaDe(d.data.tema.id),
  resumen: recortar(d.data.cita, 180),
  etiquetas: [{ texto: etiqueta(d.data.contexto) }, { texto: d.data.cargo_en_ese_momento }],
}));

const secciones = [
  // Orden deliberado: primero lo que se lee de un vistazo y responde "¿cumplió, cambió, dice la
  // verdad?", y al final las declaraciones, que son la lista de referencia de la que sale todo lo
  // anterior. Puestas primero, son un muro de texto que entierra los indicadores.
  { ancla: 'promesas', nombre: 'Promesas', n: misPromesas.length },
  { ancla: 'giros', nombre: 'Giros', n: misGiros.length },
  { ancla: 'veracimetro', nombre: 'Veracímetro', n: misChequeos.length },
  { ancla: 'vetos', nombre: 'Vetos', n: misVetos.length },
  { ancla: 'casos', nombre: 'Casos', n: misCasos.length },
  { ancla: 'patrimonio', nombre: 'Patrimonio', n: miPatrimonio.length },
  { ancla: 'sustancia', nombre: 'Sustancia del discurso', n: misIntervenciones.length },
  { ancla: 'referentes', nombre: 'Referentes', n: misMenciones.length },
  { ancla: 'declaraciones', nombre: 'Declaraciones', n: misDeclaraciones.length },
];

const foto = politico.data.foto;
const VACIO = 'Todavía no hay registros publicados.';

// "No hay vetos" y "nadie miró si hubo vetos" se ven iguales en una seccion vacia, y confundirlos
// se lee como cobertura desigual. Las corridas hechas estan en data/corridas/ y son publicas, asi
// que el sitio puede decir cual de las dos cosas es.
const corridas = leerCorridas(todosLosPoliticos.map((p) => p.id));

// Meses de mandato acumulados. Sin este dato, "cuatro vetos contra cero" se lee como una
// diferencia de conducta cuando puede ser una diferencia de tiempo transcurrido.
const mesesDeMandato = (() => {
  const mandatos = politico.data.mandatos ?? [];
  if (mandatos.length === 0) return null;
  const hoy = new Date();
  let meses = 0;
  for (const m of mandatos) {
    const desde = new Date(completarFecha(m.desde, 'inicio'));
    const hasta = m.hasta ? new Date(m.hasta) : hoy;
    if (Number.isNaN(desde.getTime()) || Number.isNaN(hasta.getTime())) continue;
    meses += (hasta.getFullYear() - desde.getFullYear()) * 12 + (hasta.getMonth() - desde.getMonth());
  }
  return meses > 0 ? meses : null;
})();
function vacioDe(objeto: string, queSeBusco: string): string {
  const cuando = fechaInvestigacion(corridas, slug, objeto);
  return cuando
    ? `Se investigó el ${fechaLarga(cuando)} y no se encontró ${queSeBusco}. La ausencia está documentada en el rastro de esa corrida, no es que falte investigar.`
    : VACIO;
}
const titulo = politico.data.nombre_corto;
---

<Base titulo={titulo} descripcion={`${politico.data.nombre}, ${politico.data.partido}. Declaraciones, giros, promesas, chequeos, patrimonio declarado y casos, cada uno con su fuente.`}>
  <article>
    <h1>{politico.data.nombre_corto}</h1>
    <div class="encabezado">
      {
        foto && (
          <figure class="foto">
            <img
              src={ruta(foto.url)}
              alt={`Fotografía de ${politico.data.nombre}`}
              width="160"
              height="200"
              decoding="async"
            />
            <figcaption class="muy-chico">
              Foto: {foto.credito} ·{' '}
              {foto.licencia_url ? (
                <a href={foto.licencia_url} rel="external license">
                  {foto.licencia}
                </a>
              ) : (
                foto.licencia
              )}
              {foto.pagina && (
                <>
                  {' '}
                  ·{' '}
                  <a href={foto.pagina} rel="external">
                    archivo original
                  </a>
                </>
              )}
            </figcaption>
          </figure>
        )
      }
      <div class="encabezado-datos">
        <p class="chico">{politico.data.nombre} · {politico.data.partido}</p>
        <EstadoActual politico={politico} />
      </div>
    </div>

    <h2 class="visualmente-oculto" id="mandatos">Mandatos</h2>
    <ul class="mandatos">
      {
        /* Ordenados acá y no en el YAML: depender de que cada agente los liste en orden hace que un
           descuido de carga se vea como una cronología equivocada, que es peor que el descuido. */
        [...politico.data.mandatos]
          .sort(
            (a, b) =>
              completarFecha(a.desde, 'inicio').localeCompare(completarFecha(b.desde, 'inicio')) ||
              completarFecha(a.hasta ?? '9999', 'fin').localeCompare(completarFecha(b.hasta ?? '9999', 'fin')),
          )
          .map((m) => (
          <li>
            <strong>{m.cargo}</strong>{' '}
            <span class="chico">
              {fechaParcialLarga(m.desde)} – {m.hasta ? fechaParcialLarga(m.hasta) : 'actualidad'}
            </span>
          </li>
        ))
      }
    </ul>

    <nav aria-label="Secciones de esta página">
      <ul class="subnav">
        {
          secciones.map((s) => (
            <li>
              <a href={`#${s.ancla}`}>
                {s.nombre} <span class="muy-chico">({s.n})</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      nProbables > 0 && (
        <p class="aviso">
          Hay {nProbables} {plural(nProbables, 'registro', 'registros')} de esta persona en estado{' '}
          <strong>probable</strong>, que no cumplen todavía todas las reglas de publicación y no se muestran en esta
          página. Se pueden leer en <a href={ruta('/probable/')}>/probable/</a>, con banner permanente.
        </p>
      )
    }

    <CompartirBar titulo={`${politico.data.nombre_corto} en La Casta`} />

    <Cobertura slug={slug} titulo={`Qué de ${politico.data.nombre_corto} revisamos`} />

    <section class="seccion" id="promesas">
      <h2>Promesas <span class="n">({misPromesas.length})</span></h2>
      <p class="chico">
        Escala de Chequeado y la diaria Verifica: cumplida, en proceso adelantada, en proceso demorada, incumplida. Cada
        promesa lista los hechos posteriores que la afectan, con su efecto a favor o en contra.
      </p>
      {
        misPromesas.length === 0 ? (
          <p class="vacio">{VACIO}</p>
        ) : (
          misPromesas.map((p) => <PromesaCard promesa={p} tema={temaDe(p.data.tema.id)} />)
        )
      }
    </section>

    <section class="seccion" id="giros">
      <h2>Giros <span class="n">({misGiros.length})</span></h2>
      <p class="chico">
        Un giro compara dos declaraciones propias sobre el mismo tema y las califica por cambio (sin cambio, parcial,
        total) y por cómo lo explicó (lo reconoció, lo justificó por contexto, no lo explicó). Los «sin cambio» también
        se publican.
      </p>
      {
        misGiros.length === 0 ? (
          <p class="vacio">{VACIO}</p>
        ) : (
          misGiros.map((g) => {
            const antes = declaracionesPorId.get(g.data.declaracion_antes.id);
            const despues = declaracionesPorId.get(g.data.declaracion_despues.id);
            return antes && despues ? (
              <GiroCard giro={g} antes={antes} despues={despues} tema={temaDe(g.data.tema.id)} />
            ) : null;
          })
        )
      }
    </section>

    <section class="seccion" id="veracimetro">
      <h2>Veracímetro <span class="n">({misChequeos.length})</span></h2>
      <Veracimetro chequeos={misChequeos} temas={mapaTemas} />
      {misChequeos.slice(0, 5).map((c) => <ChequeoCard chequeo={c} tema={temaDe(c.data.tema.id)} />)}
    </section>

    <section class="seccion" id="vetos">
      <h2>Vetos <span class="n">({misVetos.length})</span></h2>
      {
        mesesDeMandato !== null && (
          <p class="chico contexto-veto">
            Contando <strong>{mesesDeMandato} {mesesDeMandato === 1 ? 'mes' : 'meses'}</strong> de mandato
            {misVetos.length === 0 ? ' sin vetos registrados' : ''}. Dos cosas hay que mirar antes de comparar este
            número con el de otro presidente. Una es el tiempo: un mandato de cinco años tuvo cinco veces más
            oportunidades de vetar que uno de un año. La otra es el método: un veto aparece o no según dónde se lo
            busque, y las búsquedas de cada presidente no siempre tuvieron la misma profundidad. El método de cada una
            está escrito en el rastro público de su corrida.
          </p>
        )
      }
      <p class="chico">
        El veto es la facultad por la que el presidente frena, solo con su firma, un proyecto que ya aprobaron las dos
        cámaras. No es la última palabra: la Asamblea General puede levantarlo con la mayoría especial que fija la
        Constitución. Por eso cada veto se registra con su argumento y con lo que el Parlamento hizo después.
      </p>
      {
        misVetos.length === 0 ? (
          <p class="vacio">
            {vacioDe('vetos', 'ningún veto en este mandato')} Cada veto guarda el proyecto observado, si fue total o
            parcial, qué artículos se observaron, el argumento del Poder Ejecutivo y el desenlace parlamentario, cada
            uno con su fuente.
          </p>
        ) : (
          misVetos.map((v) => <VetoCard veto={v} tema={temaDe(v.data.tema.id)} />)
        )
      }
    </section>

    <section class="seccion" id="casos">
      <h2>Casos <span class="n">({misCasos.length})</span></h2>
      <p class="chico">
        Solo se reproduce lo que ya está en fuentes públicas, con la etapa judicial y su fecha siempre visibles. Una
        denuncia no es una condena, y el sitio lo dice en cada caso. Es la única sección con aprobación humana
        obligatoria.
      </p>
      {
        misCasos.length === 0 ? (
          <p class="vacio">{VACIO}</p>
        ) : (
          misCasos.map((c) => <CasoCard caso={c} politicos={nombresPoliticos} />)
        )
      }
    </section>

    <section class="seccion" id="patrimonio">
      <h2>Patrimonio declarado <span class="n">({miPatrimonio.length})</span></h2>
      <PatrimonioChart politico={politico} declaraciones={miPatrimonio} />
    </section>

    <section class="seccion" id="sustancia">
      <h2>Sustancia del discurso <span class="n">({misIntervenciones.length})</span></h2>
      <Sustancia resumen={resumen} />
      {
        misIntervenciones.length > 0 && (
          <>
            <h3>Intervenciones transcritas</h3>
            <ul>
              {misIntervenciones.map((i) => (
                <li>
                  <a href={urlDe('intervenciones', i.id)}>{i.data.titulo}</a>{' '}
                  <span class="chico">
                    · {etiqueta(i.data.tipo)} · <time datetime={i.data.fecha}>{fechaLarga(i.data.fecha)}</time> ·{' '}
                    {i.data.palabras} palabras
                  </span>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </section>

    <section class="seccion" id="referentes">
      <h2>Referentes <span class="n">({misMenciones.length})</span></h2>
      <p class="chico">
        A quién cita como autoridad, a quién reivindica y a quién critica. Las citas son de{' '}
        {politico.data.nombre_corto}; el título de cada ficha es la persona de la que habla.
      </p>
      {
        misMenciones.length === 0 ? (
          <p class="vacio">{VACIO}</p>
        ) : (
          <MencionesDe
            menciones={misMenciones}
            autor={politico}
            referentes={mapaReferentes}
            politicos={mapaPoliticos}
          />
        )
      }
    </section>

    <section class="seccion" id="declaraciones">
      <h2>Declaraciones <span class="n">({misDeclaraciones.length})</span></h2>
      {
        misDeclaraciones.length === 0 ? (
          <p class="vacio">
            {VACIO} Cada declaración guarda la cita textual, la fecha, el contexto (campaña, gobierno, oposición,
            entrevista, parlamento, redes), el cargo que ocupaba en ese momento y las fuentes.
          </p>
        ) : (
          <Timeline items={itemsTimeline} id="tl-declaraciones" />
        )
      }
    </section>

    <Procedencia procedencia={politico.data.procedencia} id={politico.id} coleccion="politicos" />
  </article>
</Base>

<style>
  .encabezado {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-4);
    align-items: flex-start;
    margin-bottom: var(--e-4);
  }
  .encabezado-datos {
    flex: 1 1 18rem;
    min-width: 0;
  }
  .encabezado-datos > :last-child {
    margin-bottom: 0;
  }
  .foto {
    flex: none;
    margin: 0;
    max-width: 10rem;
  }
  .foto img {
    width: 10rem;
    height: 12.5rem;
    object-fit: cover;
    object-position: top center;
    border-radius: var(--radio);
    background: var(--fondo-3);
    border: 1px solid var(--borde);
  }
  .foto figcaption {
    margin-top: var(--e-1);
  }
  .mandatos {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--e-4);
  }
  .mandatos li {
    margin-bottom: var(--e-1);
  }
</style>
