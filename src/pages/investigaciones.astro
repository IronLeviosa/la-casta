---
/**
 * Investigaciones en curso: los casos que la justicia todavía no resolvió.
 *
 * El sitio ya muestra cada caso por separado, pero no responde la pregunta que la gente se hace
 * cuando un político queda involucrado en una acusación: en qué quedó. Esta página junta los casos
 * abiertos y, sobre todo, muestra **cuánto hace que no se mueven**, que es el dato que permite ver
 * si el proceso avanza.
 *
 * Un cuidado que atraviesa toda la página: el tiempo sin movimiento no prueba nada por sí solo.
 * Una investigación puede estar activa sin producir actos públicos, y una causa compleja demora.
 * La página muestra fechas, no conclusiones, y lo dice.
 */
import Base from '../layouts/Base.astro';
import { publicados, servibles } from '../lib/contenido';
import { urlDe } from '../lib/permalinks';
import { fechaLarga } from '../lib/formato';
import { ruta } from '../lib/ruta';

const [casos, politicos] = await Promise.all([servibles('casos'), publicados('politicos')]);
const nombres = new Map(politicos.map((p) => [p.id, p.data.nombre_corto]));

/** Abierto = la justicia todavía no lo resolvió. Cerrado = condena, absolución o archivo. */
const ABIERTOS = new Set(['denuncia', 'formalizado']);
const HOY = new Date();

const ETIQUETA_ROL: Record<string, string> = {
  imputado: 'imputado',
  bajo_su_mando: 'ocurrió bajo su mando',
  mencionado: 'mencionado',
  denunciante: 'denunciante',
};

interface Fila {
  id: string;
  nombre: string;
  href: string;
  involucrados: { nombre: string; rol: string }[];
  ultimaEtapa: string;
  ultimaFecha: string;
  meses: number;
  queFalta?: string;
  tier: string;
}

const filas: Fila[] = casos
  .filter((c) => ABIERTOS.has(String(c.data.etiqueta_legal)))
  .map((c) => {
    const etapas = [...(c.data.estado_judicial ?? [])].sort((a: any, b: any) => a.fecha.localeCompare(b.fecha));
    const ultima = etapas.at(-1);
    const fecha = String(ultima?.fecha ?? '');
    const meses = fecha ? Math.max(0, Math.round((HOY.getTime() - new Date(fecha).getTime()) / (1000 * 60 * 60 * 24 * 30.44))) : 0;
    return {
      id: c.id,
      nombre: c.data.nombre,
      href: urlDe('casos', c.id),
      involucrados: (c.data.involucrados ?? []).map((i: any) => ({
        nombre: nombres.get(i.politico.id) ?? i.politico.id,
        rol: ETIQUETA_ROL[i.rol] ?? i.rol,
      })),
      ultimaEtapa: String(ultima?.etapa ?? ''),
      ultimaFecha: fecha,
      meses,
      queFalta: c.data.revision?.que_falta,
      tier: String(c.data.revision?.tier ?? ''),
    };
  })
  .sort((a, b) => b.meses - a.meses);

const cerrados = casos.filter((c) => !ABIERTOS.has(String(c.data.etiqueta_legal)));
---

<Base
  titulo="Investigaciones en curso"
  descripcion="Casos que la justicia todavía no resolvió, con la fecha de su último movimiento registrado."
>
  <h1>Investigaciones en curso</h1>
  <div class="prosa">
    <p>
      Cuando un político queda involucrado en una acusación, la noticia dura unos días y después
      desaparece. Lo que casi nunca se cuenta es en qué terminó. Acá están los casos que la justicia
      todavía no resolvió, ordenados por cuánto hace que no registran un movimiento público.
    </p>
    <p>
      <strong>El tiempo sin movimiento no prueba nada por sí solo.</strong> Una investigación puede
      estar activa sin producir actos públicos, una causa compleja demora, y lo que acá se ve es lo
      que quedó documentado en fuentes públicas, no el expediente. Si un caso figura sin novedades es
      tan posible que no haya habido novedades como que no las hayamos encontrado; cuando es lo
      segundo, la ficha lo dice.
    </p>
    <p class="chico">
      Los casos que ya terminaron en condena, absolución o archivo no están acá:{' '}
      <a href={ruta('/casos/')}>se leen en la sección de casos</a>, con su desenlace.
    </p>
  </div>

  {
    filas.length === 0 ? (
      <p class="vacio">
        Ningún caso registrado está abierto: todos los que hay terminaron en condena, absolución o archivo.
      </p>
    ) : (
      <ol class="lista-investigaciones">
        {filas.map((f) => (
          <li class="tarjeta">
            <div class="insignias">
              <span class="insignia insignia-amarillo">Sin resolver</span>
              {f.involucrados.map((i) => (
                <span class="insignia">
                  {i.nombre} <span class="chico">· {i.rol}</span>
                </span>
              ))}
              {f.tier === 'probable' && <span class="insignia">Probable</span>}
            </div>
            <h2>
              <a href={f.href}>{f.nombre}</a>
            </h2>
            <p class="movimiento">
              Último movimiento registrado: <strong>{f.ultimaEtapa}</strong>, el{' '}
              <time datetime={f.ultimaFecha}>{fechaLarga(f.ultimaFecha)}</time>.{' '}
              {f.meses === 0 ? 'Este mes.' : f.meses === 1 ? 'Hace un mes.' : `Hace ${f.meses} meses.`}
            </p>
            {f.queFalta && (
              <p class="chico">
                <strong>Qué falta averiguar:</strong> {f.queFalta}
              </p>
            )}
          </li>
        ))}
      </ol>
    )
  }

  {
    cerrados.length > 0 && (
      <p class="chico cerrados">
        Además hay {cerrados.length} {cerrados.length === 1 ? 'caso ya resuelto' : 'casos ya resueltos'} por la justicia:{' '}
        {cerrados.map((c, i) => (
          <>
            {i > 0 && ', '}
            <a href={urlDe('casos', c.id)}>{c.data.nombre}</a>
          </>
        ))}
        .
      </p>
    )
  }
</Base>

<style>
  .lista-investigaciones {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--e-4);
  }
  .lista-investigaciones h2 {
    margin: var(--e-1) 0 var(--e-2);
    font-size: var(--t-lg);
  }
  .movimiento {
    margin: 0 0 var(--e-2);
  }
  .cerrados {
    margin-top: var(--e-5);
  }
</style>
