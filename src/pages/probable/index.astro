---
/**
 * Registros en tier `probable`: lo que la evidencia sostiene a medias.
 *
 * La página tiene que responder de un vistazo cuatro cosas por registro: de qué tipo es, de quién
 * habla y de qué partido es esa persona, de qué tema, y por qué no está publicado. El motivo se
 * deriva del propio registro con las reglas del validador (src/lib/probable.ts), no de las notas
 * internas del editor, que por esquema no se muestran.
 *
 * El filtro es CSS puro con `:target`, igual que el de la línea de tiempo: sin JavaScript.
 */
import Base from '../../layouts/Base.astro';
import TierBanner from '../../components/TierBanner.astro';
import { probables, publicados } from '../../lib/contenido';
import { recortar } from '../../lib/formato';
import { NOMBRE_COLECCION, urlDe } from '../../lib/permalinks';
import { motivosProbable, type Motivo } from '../../lib/probable';
import type { NombreColeccion } from '../../schemas/base';
import { ruta } from '../../lib/ruta';

const [politicos, temas, medios] = await Promise.all([publicados('politicos'), publicados('temas'), publicados('medios')]);
const infoPolitico = new Map(politicos.map((p) => [p.id, { nombre: p.data.nombre_corto, partido: p.data.partido }]));
const nombreTema = new Map(temas.map((t) => [t.id, t.data.nombre]));
const grupoPorMedio = new Map(medios.map((m) => [m.id, m.data.grupo]));

const COLECCIONES = ['declaraciones', 'giros', 'promesas', 'chequeos', 'casos', 'vetos', 'intervenciones'] as const;
const listas = await Promise.all(COLECCIONES.map((c) => probables(c)));
// Un giro o un chequeo que se apoya en una declaración probable hereda ese estado.
const probablesPorColeccion = new Map(COLECCIONES.map((c, i) => [c as string, new Set(listas[i].map((e) => e.id))]));

interface Fila {
  coleccion: NombreColeccion;
  id: string;
  href: string;
  resumen: string;
  personas: { slug: string; nombre: string; partido: string }[];
  tema?: { slug: string; nombre: string };
  motivos: Motivo[];
}

/** Título corto: una línea, no un párrafo. La ficha completa está a un clic. */
function resumenDe(coleccion: string, d: Record<string, any>): string {
  switch (coleccion) {
    case 'declaraciones':
      return recortar(d.cita, 110);
    case 'giros':
      return recortar(d.analisis, 110);
    case 'promesas':
      return recortar(d.texto, 110);
    case 'chequeos':
      return recortar(d.afirmacion, 110);
    case 'casos':
      return d.nombre;
    case 'vetos':
      return d.titulo;
    default:
      return d.titulo ?? d.resumen ?? '';
  }
}

function personasDe(d: Record<string, any>): string[] {
  if (Array.isArray(d.involucrados)) return d.involucrados.map((i: any) => i.politico.id);
  return d.politico ? [d.politico.id] : [];
}

const filas: Fila[] = [];
COLECCIONES.forEach((coleccion, i) => {
  for (const e of listas[i]) {
    const d = e.data as Record<string, any>;
    filas.push({
      coleccion,
      id: e.id,
      href: urlDe(coleccion, e.id),
      resumen: resumenDe(coleccion, d),
      personas: personasDe(d).map((slug) => ({
        slug,
        nombre: infoPolitico.get(slug)?.nombre ?? slug,
        partido: infoPolitico.get(slug)?.partido ?? 'sin partido registrado',
      })),
      tema: d.tema ? { slug: d.tema.id, nombre: nombreTema.get(d.tema.id) ?? d.tema.id } : undefined,
      motivos: motivosProbable(coleccion, d, grupoPorMedio, probablesPorColeccion),
    });
  }
});

const slug = (s: string) => s.replace(/[^a-z0-9]+/gi, '-').toLowerCase();
const clasesDe = (f: Fila) =>
  [
    `f-tipo-${f.coleccion}`,
    ...f.personas.map((p) => `f-persona-${p.slug}`),
    ...f.personas.map((p) => `f-partido-${slug(p.partido)}`),
    ...(f.tema ? [`f-tema-${slug(f.tema.slug)}`] : []),
    ...f.motivos.map((m) => `f-motivo-${m.clave}`),
  ].join(' ');

/** Cada filtro es un ancla; `:target` decide qué se ve. Un filtro a la vez. */
interface Filtro {
  clase: string;
  etiqueta: string;
  n: number;
}
function filtros(claves: (f: Fila) => { clase: string; etiqueta: string }[]): Filtro[] {
  const m = new Map<string, Filtro>();
  for (const f of filas) {
    for (const { clase, etiqueta } of claves(f)) {
      const prev = m.get(clase);
      if (prev) prev.n += 1;
      else m.set(clase, { clase, etiqueta, n: 1 });
    }
  }
  return [...m.values()].sort((a, b) => b.n - a.n);
}

const porPersona = filtros((f) => f.personas.map((p) => ({ clase: `f-persona-${p.slug}`, etiqueta: p.nombre })));
const porPartido = filtros((f) => f.personas.map((p) => ({ clase: `f-partido-${slug(p.partido)}`, etiqueta: p.partido })));
const porTema = filtros((f) => (f.tema ? [{ clase: `f-tema-${slug(f.tema.slug)}`, etiqueta: f.tema.nombre }] : []));
const ETIQUETA_MOTIVO: Record<Motivo['clave'], string> = {
  'una-sola-fuente': 'Falta una segunda fuente',
  'mismo-grupo': 'Fuentes del mismo grupo',
  'sin-primaria': 'Falta registro primario',
  'sin-documento-oficial': 'Falta documento oficial',
  'espera-aprobacion': 'Espera firma humana',
  'verificacion-manual': 'Verificación manual pendiente',
  'depende-de-otro': 'Depende de otro registro',
  otro: 'Otro motivo',
};
const porMotivo = filtros((f) => f.motivos.map((m) => ({ clase: `f-motivo-${m.clave}`, etiqueta: ETIQUETA_MOTIVO[m.clave] })));
const porTipo = filtros((f) => [{ clase: `f-tipo-${f.coleccion}`, etiqueta: NOMBRE_COLECCION[f.coleccion].plural }]);

const todosLosFiltros = [...porPersona, ...porPartido, ...porTema, ...porMotivo, ...porTipo];
const css = todosLosFiltros
  .map((f) => `#lista:has(#${f.clase}:target) > .ficha:not(.${f.clase}){display:none}\n#filtros:has(~ #lista) a[href="#${f.clase}"]:target{outline:2px solid var(--acento)}`)
  .join('\n');
---

<Base
  titulo="Registros probables"
  descripcion="Registros que todavía no cumplen todas las reglas de publicación. Excluidos de los buscadores."
  noindex
>
  <Fragment slot="head">
    <style is:inline set:html={css} />
  </Fragment>

  <TierBanner tier="probable" />
  <h1>Registros probables</h1>
  <div class="prosa">
    <p>
      Acá viven los registros que la evidencia sostiene parcialmente pero que todavía no cumplen todas las reglas para
      publicarse. Cada uno dice por qué está acá, y ese motivo no es una nota suelta: sale de aplicarle al registro la
      misma regla que lo bloqueó.
    </p>
    <p>
      Esta sección existe por honestidad: esconder lo que está a medio verificar sería tan engañoso como publicarlo como
      si estuviera confirmado. Toda la sección lleva <code>noindex</code>, no aparece en los buscadores, y cada registro
      lleva su banner permanente. Lo que hay acá <strong>puede cambiar o retirarse</strong>.
    </p>
    <p class="chico">
      Las hipótesis privadas del detective no están acá ni en ninguna página: viven fuera del repositorio público y
      nunca se publican como tales. Ver <a href={ruta('/metodologia/')}>metodología</a>.
    </p>
  </div>

  {
    filas.length === 0 ? (
      <p class="vacio">Ahora mismo no hay ningún registro en estado probable.</p>
    ) : (
      <>
        {todosLosFiltros.map((f) => (
          <span id={f.clase} class="ancla-filtro" />
        ))}
        <nav id="filtros" class="filtros" aria-label="Filtrar los registros probables">
          {[
            ['Por qué está acá', porMotivo],
            ['Persona', porPersona],
            ['Partido', porPartido],
            ['Tema', porTema],
            ['Tipo', porTipo],
          ].map(([titulo, lista]) =>
            (lista as Filtro[]).length > 0 ? (
              <div class="grupo-filtro">
                <span class="chico">{titulo}:</span>
                {(lista as Filtro[]).map((f) => (
                  <a href={`#${f.clase}`}>
                    {f.etiqueta} <span class="n">{f.n}</span>
                  </a>
                ))}
              </div>
            ) : null,
          )}
          <a class="limpiar" href="#filtros">Ver todos ({filas.length})</a>
        </nav>

        <div id="lista">
          {filas.map((f) => (
            <article class:list={['ficha', 'tarjeta', clasesDe(f)]}>
              <div class="insignias">
                <span class="insignia">{NOMBRE_COLECCION[f.coleccion].singular}</span>
                {f.personas.map((p) => (
                  <span class="insignia insignia-persona">
                    {p.nombre} <span class="chico">· {p.partido}</span>
                  </span>
                ))}
                {f.tema && (
                  <a class="insignia" href={ruta(`/temas/${f.tema.slug}/`)}>
                    {f.tema.nombre}
                  </a>
                )}
              </div>
              <p class="resumen">
                <a href={f.href}>{f.resumen}</a>
              </p>
              <ul class="motivos">
                {f.motivos.map((m) => (
                  <li>
                    <strong>{ETIQUETA_MOTIVO[m.clave]}.</strong> {m.texto}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </>
    )
  }
</Base>

<style>
  .ancla-filtro {
    display: block;
    height: 0;
  }
  .filtros {
    display: grid;
    gap: var(--e-2);
    margin-bottom: var(--e-5);
    padding: var(--e-3) var(--e-4);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    background: var(--fondo-2);
  }
  .grupo-filtro {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--e-1) var(--e-2);
  }
  .grupo-filtro > span:first-child {
    min-width: 8.5rem;
    color: var(--texto-2);
  }
  .filtros a {
    display: inline-block;
    padding: 0 var(--e-2);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    font-size: var(--t-sm);
    text-decoration: none;
  }
  .filtros a:hover {
    border-color: var(--acento);
  }
  .filtros .n {
    color: var(--texto-3);
  }
  .limpiar {
    justify-self: start;
    font-weight: 700;
  }
  .ficha .insignias {
    margin-bottom: var(--e-2);
  }
  .insignia-persona {
    font-weight: 700;
  }
  .resumen {
    font-size: var(--t-md);
    margin: 0 0 var(--e-2);
  }
  .motivos {
    margin: 0;
    padding-left: var(--e-5);
    font-size: var(--t-sm);
    color: var(--texto-2);
  }
</style>
