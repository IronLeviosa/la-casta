---
import '../styles/global.css';
import '../styles/print.css';
import { presidentes } from '../lib/contenido';
import { absoluta } from '../lib/permalinks';

interface Props {
  titulo: string;
  descripcion?: string;
  /** Ruta canónica (con barra final). Por defecto, la actual. */
  ruta?: string;
  noindex?: boolean;
  /** Tipo Open Graph. */
  tipo?: 'website' | 'article';
  /** Fecha ISO de última modificación (article:modified_time). */
  actualizado?: string;
}

const { titulo, descripcion, ruta, noindex = false, tipo = 'website', actualizado } = Astro.props;
const rutaActual = ruta ?? Astro.url.pathname;
const canonica = absoluta(rutaActual, Astro.site);
const tituloCompleto = rutaActual === '/' ? 'La Casta' : `${titulo} · La Casta`;
const desc =
  descripcion ??
  'Registro verificable de lo que dijeron, prometieron, hicieron y declararon los representantes uruguayos: presidentes, senadores y diputados desde 2000. Cada afirmación con fuente.';

const presis = await presidentes();
const enlaces = [
  { href: '/temas/', texto: 'Temas' },
  { href: '/eventos/', texto: 'Eventos' },
  { href: '/medios/', texto: 'Medios' },
  { href: '/metodologia/', texto: 'Metodología' },
  { href: '/replica/', texto: 'Réplica' },
];
const esActual = (href: string) => (rutaActual === href || (href !== '/' && rutaActual.startsWith(href)) ? 'page' : undefined);
/** "Luis Lacalle Pou" → "Lacalle Pou": el nombre corto sin el nombre de pila. */
const apellido = (nombreCorto: string) => nombreCorto.split(' ').slice(1).join(' ') || nombreCorto;
/* Enlace al repositorio: reemplazar cuando se publique. */
const REPO = 'https://github.com/IronLeviosa/la-casta';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content="La Casta" />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="es_UY" />
    {actualizado && <meta property="article:modified_time" content={actualizado} />}
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <a class="salto" href="#contenido">Saltar al contenido</a>
    <header class="cabecera">
      <div class="contenedor">
        <a class="marca" href="/">La Casta</a>
        <nav aria-label="Principal">
          <ul class="nav">
            {
              presis.map((p) => (
                <li>
                  <a href={`/politicos/${p.id}/`} aria-current={esActual(`/politicos/${p.id}/`)}>
                    {apellido(p.data.nombre_corto)}
                  </a>
                </li>
              ))
            }
            <li class="nav-sep" aria-hidden="true">·</li>
            {
              enlaces.map((e) => (
                <li>
                  <a href={e.href} aria-current={esActual(e.href)}>
                    {e.texto}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="contenido" class="contenedor">
      <slot />
    </main>
    <footer class="pie">
      <div class="contenedor">
        <p class="divulgacion">
          Este sitio es producido por una IA (Claude) supervisada por un humano. Ver <a href="/sobre/">/sobre/</a> y
          <a href="/metodologia/">/metodologia/</a>.
        </p>
        <ul>
          <li><a href="/correcciones/">Correcciones</a></li>
          <li><a href="/replica/">Réplica</a></li>
          <li><a href="/datos/">Datos abiertos</a></li>
          <li><a href="/privacidad/">Privacidad</a></li>
          <li><a href="/reclamos/">Reclamos</a></li>
          <li><a href="/sesgo-de-medios/">Sesgo de medios</a></li>
          <li><a href={REPO} rel="external">Repositorio</a></li>
        </ul>
        <p class="muy-chico">
          Contenido bajo licencia abierta (ver LICENSE-CONTENIDO en el repositorio). Sin cookies, sin analítica, sin
          publicidad.
        </p>
      </div>
    </footer>
  </body>
</html>
