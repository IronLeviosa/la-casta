---
import '../styles/global.css';
import '../styles/print.css';
import { ruta, sitio, urlAbsoluta } from '../lib/ruta';

interface Props {
  titulo: string;
  descripcion?: string;
  /** Ruta canónica del sitio, sin el base (con barra final). Por defecto, la actual. */
  ruta?: string;
  noindex?: boolean;
  /** Tipo Open Graph. */
  tipo?: 'website' | 'article';
  /** Fecha ISO de última modificación (article:modified_time). */
  actualizado?: string;
}

const { titulo, descripcion, ruta: rutaProp, noindex = false, tipo = 'website', actualizado } = Astro.props;
/* Siempre con el base adentro: `Astro.url.pathname` ya lo trae y `ruta()` es idempotente. */
const rutaActual = ruta(rutaProp ?? Astro.url.pathname);
const raiz = ruta('/');
const canonica = urlAbsoluta(rutaActual);
const tituloCompleto = rutaActual === raiz ? 'La Casta' : `${titulo} · La Casta`;
/* El CSS de impresión antepone el origen a los enlaces internos (que ya llevan el base). */
const varOrigen = `:root { --origen-sitio: "${sitio()}"; }`;
const desc =
  descripcion ??
  'Registro verificable de lo que dijeron, prometieron, hicieron y declararon los representantes uruguayos: presidentes, senadores y diputados desde 2000. Cada afirmación con fuente.';

/* Los presidentes son una categoría de políticos, no una sección aparte: se entra por /politicos/. */
const enlaces = [
  { href: ruta('/politicos/'), texto: 'Políticos' },
  { href: ruta('/temas/'), texto: 'Temas' },
  { href: ruta('/eventos/'), texto: 'Eventos' },
  { href: ruta('/medios/'), texto: 'Medios' },
  { href: ruta('/metodologia/'), texto: 'Metodología' },
  { href: ruta('/replica/'), texto: 'Réplica' },
];
const esActual = (href: string) => (rutaActual === href || (href !== raiz && rutaActual.startsWith(href)) ? 'page' : undefined);
/* Enlace al repositorio: reemplazar cuando se publique. */
const REPO = 'https://github.com/IronLeviosa/la-casta';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href={ruta('/favicon.svg')} type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content="La Casta" />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="es_UY" />
    {actualizado && <meta property="article:modified_time" content={actualizado} />}
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    <style is:global set:html={varOrigen}></style>
    <slot name="head" />
  </head>
  <body>
    <a class="salto" href="#contenido">Saltar al contenido</a>
    <header class="cabecera">
      <div class="contenedor">
        <a class="marca" href={raiz}>La Casta</a>
        <nav aria-label="Principal">
          <ul class="nav">
            {
              enlaces.map((e) => (
                <li>
                  <a href={e.href} aria-current={esActual(e.href)}>
                    {e.texto}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="contenido" class="contenedor">
      <slot />
    </main>
    <footer class="pie">
      <div class="contenedor">
        <p class="divulgacion">
          Este sitio es producido por una IA (Claude) supervisada por un humano. Ver <a href={ruta('/sobre/')}>/sobre/</a> y
          <a href={ruta('/metodologia/')}>/metodologia/</a>.
        </p>
        <ul>
          <li><a href={ruta('/correcciones/')}>Correcciones</a></li>
          <li><a href={ruta('/replica/')}>Réplica</a></li>
          <li><a href={ruta('/datos/')}>Datos abiertos</a></li>
          <li><a href={ruta('/privacidad/')}>Privacidad</a></li>
          <li><a href={ruta('/reclamos/')}>Reclamos</a></li>
          <li><a href={ruta('/sesgo-de-medios/')}>Sesgo de medios</a></li>
          <li><a href={REPO} rel="external">Repositorio</a></li>
        </ul>
        <p class="muy-chico">
          Contenido bajo licencia abierta (ver LICENSE-CONTENIDO en el repositorio). Sin cookies, sin analítica, sin
          publicidad.
        </p>
      </div>
    </footer>
  </body>
</html>
