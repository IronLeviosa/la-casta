---
/**
 * Un gráfico chico, dibujado al construir el sitio, a partir de los números que ya están en el
 * registro.
 *
 * Existe porque un chequeo que compara cifras (resultados por año, precios por país) se entiende
 * en un vistazo con barras y cuesta tres párrafos en prosa. Un lector señaló exactamente eso: el
 * balance de ANCAP año por año, con los negativos a la vista, dice más que el texto que lo cuenta.
 *
 * Reglas, todas de lo que el lector señaló después: los números salen de `dato_real` y cada serie
 * declara su fuente, que se imprime al pie; series del mismo producto en dos países comparten el
 * color y se distinguen por el trazo (continuo y punteado), porque cuatro colores no se siguen;
 * los años del eje no se pisan (si hay más de diez, se rotula uno de cada tantos); la nota al pie
 * es corta y el método va plegado bajo "Cómo se calculó"; y debajo va la tabla con los valores.
 * No se cargan librerías: es SVG estático.
 */
import { parrafos } from '../lib/formato';

interface Punto {
  x: string;
  y: number;
  nota?: string;
}
interface Serie {
  nombre: string;
  fuente: string;
  color?: number;
  trazo?: 'solido' | 'punteado';
  puntos: Punto[];
}
export interface DatosGrafico {
  tipo: 'barras' | 'lineas';
  titulo: string;
  unidad: string;
  series: Serie[];
  colorear_por_signo?: boolean;
  nota?: string;
  metodo?: string;
}
interface Props {
  grafico: DatosGrafico;
}
const { grafico: g } = Astro.props;

const PALETA = ['var(--acento)', 'var(--amarillo-borde)', 'var(--texto-2)', 'var(--verde-borde)'];
const categorias = [...new Set(g.series.flatMap((s) => s.puntos.map((p) => p.x)))];
const valores = g.series.flatMap((s) => s.puntos.map((p) => p.y));
const minY = Math.min(0, ...valores);
const maxY = Math.max(0, ...valores);

// Escala "bonita": ticks redondos que cubran el rango.
function paso(rango: number): number {
  const bruto = rango / 4;
  const pot = 10 ** Math.floor(Math.log10(bruto || 1));
  const n = bruto / pot;
  return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10) * pot;
}
const p = paso(maxY - minY || 1);
const yMin = Math.floor(minY / p) * p;
const yMax = Math.ceil(maxY / p) * p || p;
const ticks: number[] = [];
for (let t = yMin; t <= yMax + 1e-9; t += p) ticks.push(Number(t.toFixed(10)));

const ANCHO = 640;
const ALTO = 300;
const M = { arriba: 18, derecha: 16, abajo: 34, izquierda: 84 };
const w = ANCHO - M.izquierda - M.derecha;
const h = ALTO - M.arriba - M.abajo;
const yDe = (v: number) => M.arriba + h - ((v - yMin) / (yMax - yMin)) * h;
const xDe = (i: number) => M.izquierda + (i + 0.5) * (w / categorias.length);
const grupo = w / categorias.length;
const anchoBarra = Math.min(48, (grupo * 0.7) / g.series.length);
// Con muchas categorías, un rótulo de cada tantos: los años pegados no se leen.
const cadaCuantos = Math.max(1, Math.ceil(categorias.length / 10));

const formatear = (n: number) =>
  new Intl.NumberFormat('es-UY', { maximumFractionDigits: Math.abs(n) < 10 ? 2 : 0 }).format(n);
const colorSerie = (s: Serie, si: number) => PALETA[((s.color ?? si + 1) - 1) % PALETA.length];
const colorDe = (s: Serie, si: number, y: number) => (g.colorear_por_signo ? (y < 0 ? 'var(--rojo-borde)' : 'var(--verde-borde)') : colorSerie(s, si));
const punteado = (s: Serie) => s.trazo === 'punteado';
const idTitulo = `grafico-${Math.random().toString(36).slice(2, 8)}`;
const fuentes = [...new Set(g.series.map((s) => s.fuente))];
const metodo = parrafos(g.metodo);
---

<figure class="grafico">
  <svg viewBox={`0 0 ${ANCHO} ${ALTO}`} role="img" aria-labelledby={idTitulo} preserveAspectRatio="xMidYMid meet">
    <title id={idTitulo}>{g.titulo} ({g.unidad})</title>
    {/* Rejilla y eje Y */}
    {
      ticks.map((t) => (
        <g>
          <line x1={M.izquierda} x2={ANCHO - M.derecha} y1={yDe(t)} y2={yDe(t)} class={t === 0 ? 'cero' : 'rejilla'} />
          <text x={M.izquierda - 8} y={yDe(t) + 4} text-anchor="end" class="tick">
            {formatear(t)}
          </text>
        </g>
      ))
    }
    {/* Datos */}
    {
      g.tipo === 'barras'
        ? g.series.map((s, si) =>
            s.puntos.map((pt) => {
              const ci = categorias.indexOf(pt.x);
              const x = xDe(ci) - (anchoBarra * g.series.length) / 2 + si * anchoBarra;
              const y0 = yDe(0);
              const y1 = yDe(pt.y);
              const alta = Math.abs(y1 - y0) >= 18;
              const adentro = pt.y < 0 && alta;
              const yEtiqueta = pt.y < 0 ? (alta ? y1 - 5 : y1 + 12) : y1 - 4;
              return (
                <g>
                  <rect
                    x={x}
                    y={Math.min(y0, y1)}
                    width={anchoBarra - 2}
                    height={Math.max(1, Math.abs(y1 - y0))}
                    fill={colorDe(s, si, pt.y)}
                    opacity={punteado(s) ? '0.55' : '0.9'}
                  >
                    <title>{`${s.nombre} · ${pt.x}: ${formatear(pt.y)} ${g.unidad}${pt.nota ? ` (${pt.nota})` : ''}`}</title>
                  </rect>
                  {categorias.length <= 14 && (
                    <text x={x + (anchoBarra - 2) / 2} y={yEtiqueta} text-anchor="middle" class={adentro ? 'valor valor-adentro' : 'valor'}>
                      {formatear(pt.y)}
                    </text>
                  )}
                </g>
              );
            }),
          )
        : g.series.map((s, si) => (
            <g>
              <polyline
                fill="none"
                stroke={colorSerie(s, si)}
                stroke-width="2.5"
                stroke-dasharray={punteado(s) ? '7 5' : undefined}
                points={s.puntos.map((pt) => `${xDe(categorias.indexOf(pt.x))},${yDe(pt.y)}`).join(' ')}
              />
              {s.puntos.map((pt) => (
                <circle
                  cx={xDe(categorias.indexOf(pt.x))}
                  cy={yDe(pt.y)}
                  r={punteado(s) ? 3 : 4}
                  fill={punteado(s) ? 'var(--fondo)' : colorDe(s, si, pt.y)}
                  stroke={colorSerie(s, si)}
                  stroke-width="2"
                >
                  <title>{`${s.nombre} · ${pt.x}: ${formatear(pt.y)} ${g.unidad}${pt.nota ? ` (${pt.nota})` : ''}`}</title>
                </circle>
              ))}
            </g>
          ))
    }
    {/* Eje X */}
    {
      categorias.map((c, i) => (
        <g>
          <line x1={xDe(i)} x2={xDe(i)} y1={ALTO - M.abajo} y2={ALTO - M.abajo + 4} class="rejilla" />
          {i % cadaCuantos === 0 && (
            <text x={xDe(i)} y={ALTO - M.abajo + 18} text-anchor="middle" class="tick">
              {c}
            </text>
          )}
        </g>
      ))
    }
    <text transform={`translate(14 ${M.arriba + h / 2}) rotate(-90)`} text-anchor="middle" class="unidad">
      {g.unidad}
    </text>
  </svg>
  {
    g.series.length > 1 && !g.colorear_por_signo && (
      <ul class="leyenda chico">
        {g.series.map((s, si) => (
          <li>
            {g.tipo === 'lineas' ? (
              <svg class="muestra-linea" viewBox="0 0 34 10" aria-hidden="true">
                <line x1="1" y1="5" x2="33" y2="5" stroke={colorSerie(s, si)} stroke-width="2.5" stroke-dasharray={punteado(s) ? '6 4' : undefined} />
              </svg>
            ) : (
              <span class="muestra" style={`background:${colorSerie(s, si)};opacity:${punteado(s) ? 0.55 : 0.9}`} />
            )}{' '}
            {s.nombre}
          </li>
        ))}
      </ul>
    )
  }
  <figcaption class="chico">
    <strong>{g.titulo}.</strong> {g.nota && <span>{g.nota} </span>}
    <span class="fuente">Fuente: {fuentes.join('; ')}.</span>
  </figcaption>
  {
    metodo.length > 0 && (
      <details class="metodo chico">
        <summary>Cómo se calculó</summary>
        {metodo.map((par) => (
          <p>{par}</p>
        ))}
      </details>
    )
  }
  <details class="tabla-datos chico">
    <summary>Ver los valores</summary>
    <table>
      <thead>
        <tr>
          <th></th>
          {g.series.map((s) => <th>{s.nombre}</th>)}
        </tr>
      </thead>
      <tbody>
        {categorias.map((c) => (
          <tr>
            <th>{c}</th>
            {g.series.map((s) => {
              const pt = s.puntos.find((q) => q.x === c);
              return <td>{pt ? `${formatear(pt.y)}${pt.nota ? ` (${pt.nota})` : ''}` : '—'}</td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</figure>

<style>
  .grafico {
    margin: var(--e-3) 0;
    max-width: 46rem;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
    font-family: inherit;
  }
  .rejilla {
    stroke: var(--borde);
    stroke-width: 1;
  }
  .cero {
    stroke: var(--texto-2);
    stroke-width: 1.5;
  }
  .tick {
    font-size: 12px;
    fill: var(--texto-2);
  }
  .valor {
    font-size: 11px;
    fill: var(--texto);
    font-variant-numeric: tabular-nums;
  }
  .valor-adentro {
    fill: var(--fondo);
    font-weight: 700;
  }
  .unidad {
    font-size: 11px;
    fill: var(--texto-3);
  }
  .leyenda {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    padding: 0;
    margin: 0.3rem 0 0;
  }
  .leyenda li {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }
  .muestra {
    display: inline-block;
    width: 0.8em;
    height: 0.8em;
    border-radius: 2px;
  }
  .muestra-linea {
    width: 2.2em;
    height: 0.7em;
  }
  figcaption {
    margin-top: 0.4rem;
    color: var(--texto-2);
    max-width: 46rem;
  }
  .fuente {
    color: var(--texto-3);
  }
  .metodo,
  .tabla-datos {
    margin-top: 0.3rem;
  }
  .metodo summary,
  .tabla-datos summary {
    cursor: pointer;
    color: var(--texto-2);
  }
  .metodo p {
    max-width: 46rem;
    margin: 0.4rem 0;
    color: var(--texto-2);
  }
  .tabla-datos table {
    border-collapse: collapse;
    margin-top: 0.3rem;
  }
  .tabla-datos th,
  .tabla-datos td {
    padding: 0.15rem 0.6rem;
    border-bottom: 1px solid var(--borde);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .tabla-datos th:first-child {
    text-align: left;
  }
</style>
