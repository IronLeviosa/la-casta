---
/**
 * Lista de fuentes de un registro, en dos bloques: la fuente primaria y la cobertura de prensa.
 *
 * Una entrevista, una conferencia o un discurso es **una** fuente aunque se citen tres pasajes.
 * La versión anterior listaba cada pasaje como una fuente más ("Fuentes (3)" para un solo audio),
 * y ponía la nota que resumía la entrevista al mismo nivel que la entrevista, cuando una es lo que
 * se dijo y la otra es cómo lo contaron. Acá las citas se agrupan por URL, y las fuentes se
 * separan según sean el registro original (audio, video, texto oficial, diario de sesiones) o
 * trabajo periodístico sobre él. Cuando no hay primaria, el bloque de cobertura se llama
 * simplemente "Fuentes": no hay contra qué cotejar, y decirlo es parte de la información.
 *
 * Segunda vuelta, de un lector: un chequeo que cita diez balances de la misma empresa mostraba
 * diez entradas iguales. Cuando un mismo publicador aporta tres o más documentos distintos, se
 * muestran como una sola línea ("ANCAP · 10 documentos oficiales, 2015-2024") con los documentos
 * y sus citas plegados debajo. Y la jerarquía: los organismos públicos (la empresa, IMPO, el
 * regulador, el Parlamento) van antes que la prensa dentro de cada bloque.
 */
import { getCollection } from 'astro:content';
import type { Fuente } from '../lib/tipos';
import FuenteGrupo from './FuenteGrupo.astro';

interface Props {
  fuentes: readonly Fuente[];
  titulo?: string;
  /** Nivel de encabezado (por defecto h3). */
  nivel?: 'h3' | 'h4';
  /** Cadena de razonamiento (evidencia de nivel inferencia). */
  cadena?: readonly string[];
}
const { fuentes, titulo = 'Fuentes', nivel = 'h3', cadena } = Astro.props;
const todosLosMedios = await getCollection('medios');
const medios = new Map(todosLosMedios.map((m) => [m.id, m.data.nombre]));
const tiposMedio = new Map(todosLosMedios.map((m) => [m.id, m.data.tipo]));
const empresas = new Map(
  todosLosMedios.filter((m) => m.data.empresa).map((m) => [m.id, typeof m.data.empresa === 'string' ? m.data.empresa : m.data.empresa!.id]),
);

const PRIMARIAS = new Set<Fuente['tipo']>(['video', 'documento_oficial', 'diario_de_sesiones']);
const medioId = (f: Fuente) => (typeof f.medio === 'string' ? f.medio : f.medio.id);
const esOficial = (f: Fuente) => tiposMedio.get(medioId(f)) === 'estatal';

function agrupar(lista: readonly Fuente[]): Fuente[][] {
  const porUrl = new Map<string, Fuente[]>();
  for (const f of lista) {
    const g = porUrl.get(f.url) ?? [];
    g.push(f);
    porUrl.set(f.url, g);
  }
  return [...porUrl.values()];
}

/** Un publicador con varios documentos (compacto) o una fuente suelta. */
type Entrada = { compacta: true; medio: string; oficial: boolean; docs: Fuente[][] } | { compacta: false; oficial: boolean; docs: Fuente[] };
const UMBRAL_COMPACTO = 3;
function ordenar(lista: readonly Fuente[]): Entrada[] {
  const grupos = agrupar(lista);
  const porMedio = new Map<string, Fuente[][]>();
  for (const g of grupos) {
    const id = medioId(g[0]);
    porMedio.set(id, [...(porMedio.get(id) ?? []), g]);
  }
  const entradas: Entrada[] = [];
  for (const [medio, docs] of porMedio) {
    const oficial = esOficial(docs[0][0]);
    if (docs.length >= UMBRAL_COMPACTO) {
      entradas.push({ compacta: true, medio, oficial, docs: [...docs].sort((a, b) => String(a[0].fecha).localeCompare(String(b[0].fecha))) });
    } else {
      for (const d of docs) entradas.push({ compacta: false, oficial, docs: d });
    }
  }
  // Organismos públicos primero; después, quien más documentos aporta; el resto en su orden.
  return entradas.sort((a, b) => Number(b.oficial) - Number(a.oficial) || Number(b.compacta) - Number(a.compacta));
}
const primarias = ordenar(fuentes.filter((f) => PRIMARIAS.has(f.tipo)));
const cobertura = ordenar(fuentes.filter((f) => !PRIMARIAS.has(f.tipo)));
const cuenta = (l: Entrada[]) => l.reduce((n, e) => n + (e.compacta ? e.docs.length : 1), 0);
const total = cuenta(primarias) + cuenta(cobertura);
const medioPrimario = (url: string): string => {
  const g = agrupar(fuentes).find((grupo) => grupo[0].url === url);
  return g ? (medios.get(medioId(g[0])) ?? medioId(g[0])) : 'el registro primario';
};
const TIPOS: Record<string, [string, string]> = {
  documento_oficial: ['documento oficial', 'documentos oficiales'],
  nota: ['nota', 'notas'],
  video: ['video', 'videos'],
  diario_de_sesiones: ['diario de sesiones', 'diarios de sesiones'],
  redes: ['publicación en redes', 'publicaciones en redes'],
};
const describir = (docs: Fuente[][]) => {
  const tipos = [...new Set(docs.map((d) => d[0].tipo))].map((t) => TIPOS[t]?.[docs.length === 1 ? 0 : 1] ?? t);
  const anios = docs.map((d) => Number(String(d[0].fecha).slice(0, 4))).filter((a) => a > 0);
  const min = Math.min(...anios);
  const max = Math.max(...anios);
  const rango = anios.length ? (min === max ? String(min) : `${min}-${max}`) : '';
  return `${docs.length} ${tipos.join(' y ')}${rango ? `, ${rango}` : ''}`;
};
const Encabezado = nivel;
---

<section class="fuentes">
  <Encabezado>{titulo} <span class="n">({total})</span></Encabezado>
  {
    cadena && cadena.length > 0 && (
      <ol class="cadena">
        {cadena.map((paso) => (
          <li>{paso}</li>
        ))}
      </ol>
    )
  }
  {
    [
      { rotulo: 'Fuente primaria', detalle: 'lo que se dijo, en el registro original', entradas: primarias, inicio: 1 },
      { rotulo: 'Cobertura de prensa', detalle: 'cómo lo contaron los medios', entradas: cobertura, inicio: cuenta(primarias) + 1 },
    ]
      .filter((b) => b.entradas.length > 0)
      .map((b) => (
        <div class="bloque">
          {primarias.length > 0 && (
            <p class="rotulo">
              {b.rotulo} <span class="chico">· {b.detalle}</span>
            </p>
          )}
          <ol class="fuentes-lista" start={b.inicio}>
            {b.entradas.map((e) =>
              e.compacta ? (
                <li class="compacta">
                  <details>
                    <summary>
                      <a href={empresas.get(e.medio) ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}/empresas/${empresas.get(e.medio)}/` : `${import.meta.env.BASE_URL.replace(/\/$/, '')}/medios/${e.medio}/`}>
                        {medios.get(e.medio) ?? e.medio}
                      </a>{' '}
                      <span class="chico">
                        · {describir(e.docs)}
                        {e.oficial ? ' · organismo público' : ''} · {e.docs.length} documentos con sus citas
                      </span>
                    </summary>
                    <ol class="fuentes-lista anidada">
                      {e.docs.map((g) => (
                        <FuenteGrupo citas={g} medios={medios} empresas={empresas} medioPrimario={medioPrimario} />
                      ))}
                    </ol>
                  </details>
                </li>
              ) : (
                <FuenteGrupo citas={e.docs} medios={medios} empresas={empresas} medioPrimario={medioPrimario} />
              ),
            )}
          </ol>
        </div>
      ))
  }
</section>

<style>
  .fuentes h3,
  .fuentes h4 {
    margin-top: var(--e-4);
  }
  .n {
    font-weight: 400;
    color: var(--texto-3);
  }
  .bloque + .bloque {
    margin-top: var(--e-2);
  }
  .rotulo {
    margin: 0 0 0.3rem;
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .rotulo .chico {
    font-weight: 400;
    color: var(--texto-3);
  }
  .fuentes-lista {
    padding-left: 1.4rem;
    margin: 0;
  }
  .compacta summary {
    cursor: pointer;
  }
  .anidada {
    margin-top: 0.4rem;
    padding-left: 1.2rem;
    border-left: 2px solid var(--borde);
  }
  .cadena {
    background: var(--fondo-2);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    padding: var(--e-2) var(--e-2) var(--e-2) 2rem;
    font-size: var(--t-sm);
  }
</style>
