---
/** Cita textual con quién, cuándo, en qué contexto y con qué cargo. */
import { datetimeConPrecision, fechaConPrecision, etiqueta } from '../lib/formato';

interface Props {
  cita: string;
  /** Fecha del registro (declaración, mención…) al que pertenece la cita; no la de una fuente, que sigue mostrándose con su propio texto. */
  fecha?: string;
  /** `fecha_precision` de ese mismo registro (docs/plan-fechas.md, D1 y D5). */
  fechaPrecision?: string;
  contexto?: string;
  cargo?: string;
  autor?: string;
  href?: string;
  compacta?: boolean;
}
const { cita, fecha, fechaPrecision, contexto, cargo, autor, href, compacta = false } = Astro.props;
---

<figure class:list={['cita', compacta && 'cita-compacta']}>
  <blockquote>
    <p>«{cita}»</p>
  </blockquote>
  <figcaption class="chico">
    {autor && <span>{autor}</span>}
    {/* Sin autor (la ficha de la propia persona) el cargo abre la línea: nada de coma suelta adelante. */}
    {cargo && <span>{autor ? ', ' : ''}{cargo}</span>}
    {fecha && (
      <span>
        {autor || cargo ? ', ' : ''}
        {href ? (
          <a href={href}>{fechaConPrecision(fecha, fechaPrecision)}</a>
        ) : (
          <time datetime={datetimeConPrecision(fecha, fechaPrecision)}>{fechaConPrecision(fecha, fechaPrecision)}</time>
        )}
      </span>
    )}
    {contexto && <span> · {etiqueta(contexto)}</span>}
  </figcaption>
</figure>

<style>
  .cita {
    margin: 0 0 var(--e-3);
  }
  .cita blockquote {
    margin-bottom: var(--e-1);
  }
  .cita blockquote p {
    margin: 0;
  }
  .cita-compacta blockquote {
    padding: var(--e-1) var(--e-3);
  }
</style>
