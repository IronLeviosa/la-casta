---
/**
 * Barra de navegación de secciones para una ficha larga (empresa, político): un enlace por sección
 * presente en la página, fija (sticky) debajo del encabezado del sitio al desplazarse, que marca
 * con un IntersectionObserver cuál sección está a la vista. En pantallas angostas es una fila
 * desplazable en vez de envolver en varias líneas de anclas, para no ocupar media pantalla fija
 * arriba de un teléfono. Sin JavaScript sigue siendo una lista de anclas comunes: el resaltado de
 * la sección visible es lo único que depende de JS.
 *
 * Existe porque una ficha de 65.000 píxeles (ANCAP) o la de un político con diez secciones no le
 * da al lector dónde agarrarse: sin esto, la única forma de saltar a una sección de más abajo es
 * desplazarse a ciegas o usar el buscador del navegador.
 */
export interface SeccionNav {
  /** Id del elemento al que apunta (sin «#»). */
  ancla: string;
  nombre: string;
}
interface Props {
  secciones: SeccionNav[];
}
const { secciones } = Astro.props;
---

{
  secciones.length > 1 && (
    <nav class="nav-secciones" aria-label="Ir a una sección de esta página" data-nav-secciones>
      <ul>
        {secciones.map((s) => (
          <li>
            <a href={`#${s.ancla}`} data-nav-ancla={s.ancla}>
              {s.nombre}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .nav-secciones {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--fondo);
    border-bottom: 1px solid var(--borde);
    margin-bottom: var(--e-4);
  }
  .nav-secciones ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-1) var(--e-2);
    list-style: none;
    margin: 0;
    padding: var(--e-2) 0;
    font-size: var(--t-sm);
  }
  .nav-secciones a {
    display: inline-block;
    text-decoration: none;
    color: var(--texto-2);
    padding: var(--e-1) var(--e-2);
    border-radius: 999px;
    border: 1px solid transparent;
    white-space: nowrap;
  }
  .nav-secciones a:hover {
    color: var(--texto);
    border-color: var(--borde);
  }
  .nav-secciones a.activo {
    background: var(--acento);
    color: var(--acento-texto);
    border-color: var(--acento);
  }
  @media (max-width: 40rem) {
    .nav-secciones ul {
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
    }
    .nav-secciones li {
      flex: none;
    }
  }
  /* La barra queda fija arriba: un salto de ancla necesita ese aire extra para que el título de la
     sección no quede tapado detrás de ella. */
  :global(main [id]) {
    scroll-margin-top: calc(var(--e-6) + 2.75rem);
  }
</style>

<script>
  /* Resalta en la barra la sección que está a la vista. Sin esto, o sin IntersectionObserver en el
     navegador, la barra sigue funcionando como una lista de anclas comunes. */
  for (const nav of document.querySelectorAll<HTMLElement>('[data-nav-secciones]')) {
    const enlaces = [...nav.querySelectorAll<HTMLAnchorElement>('a[data-nav-ancla]')];
    const objetivos = enlaces
      .map((a) => ({ a, el: document.getElementById(a.dataset.navAncla ?? '') }))
      .filter((x): x is { a: HTMLAnchorElement; el: HTMLElement } => !!x.el);
    if (!('IntersectionObserver' in window) || objetivos.length === 0) continue;

    const visibles = new Set<string>();
    let activo: string | undefined;
    const activar = (id: string) => {
      if (id === activo) return;
      activo = id;
      let elActivo: HTMLAnchorElement | undefined;
      for (const { a, el } of objetivos) {
        const on = el.id === id;
        a.classList.toggle('activo', on);
        a.removeAttribute('aria-current');
        if (on) {
          a.setAttribute('aria-current', 'true');
          elActivo = a;
        }
      }
      /* En pantallas angostas la fila se corre de lado para que el enlace activo quede a la vista.
         Se desplaza solo la fila (el ul) y nunca con scrollIntoView: ese método mueve también la
         página, y como html tiene scroll-padding-top (32 px) y la barra es fija a 0 (el enlace
         queda a 8 px del borde), cada llamada arrancaba un desplazamiento suave de 24 px hacia
         arriba que cancelaba la rueda del lector: en cada cambio de sección la página se trababa
         (ANCAP, 2026-09-10). */
      const fila = elActivo?.parentElement?.parentElement;
      if (!elActivo || !fila || fila.scrollWidth <= fila.clientWidth) return;
      const f = fila.getBoundingClientRect();
      const r = elActivo.getBoundingClientRect();
      fila.scrollTo({ left: fila.scrollLeft + (r.left - f.left) - (f.width - r.width) / 2, behavior: 'smooth' });
    };
    // Franja central de la pantalla: el orden de `objetivos` (el de la página) desempata cuando dos
    // secciones cortas están visibles a la vez.
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) visibles.add(e.target.id);
          else visibles.delete(e.target.id);
        }
        const primero = objetivos.find(({ el }) => visibles.has(el.id));
        if (primero) activar(primero.el.id);
      },
      { rootMargin: '-10% 0px -75% 0px', threshold: 0 },
    );
    for (const { el } of objetivos) observador.observe(el);
  }
</script>
