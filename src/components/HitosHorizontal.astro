---
/**
 * Línea de tiempo horizontal: una cinta que se desplaza de lado, con los hitos alternando arriba
 * y abajo de la línea, para la ficha de una empresa (diez o veinte hechos fechados en un siglo).
 *
 * Existe porque la vertical de las fichas de políticos, puesta en una empresa con quince hitos,
 * obligaba a un kilómetro de scroll antes de llegar a los números; un lector pidió menos scroll y
 * otro estilo. Sin JavaScript: `overflow-x: auto` con `scroll-snap`; las flechas del teclado y el
 * gesto de arrastre funcionan solos. Los años se marcan sobre la línea; cada hito lleva su fuente
 * plegada, porque la regla del sitio es que un hito sin fuente no existe.
 */
import { fechaCorta } from '../lib/formato';

export interface Hito {
  fecha: string;
  titulo: string;
  detalle?: string;
  fuentes?: { url: string; titulo?: string }[];
}
interface Props {
  hitos: Hito[];
  /** Nombre de la entidad, para el rótulo accesible. */
  de: string;
}
const { hitos, de } = Astro.props;
const ordenados = [...hitos].sort((a, b) => a.fecha.localeCompare(b.fecha));
const anioDe = (f: string) => f.slice(0, 4);
---

<div class="hitos" role="region" aria-label={`Línea de tiempo de ${de}`} tabindex="0">
  <ol class="cinta">
    {
      ordenados.map((h, i) => (
        <li class:list={['hito', i % 2 === 0 ? 'arriba' : 'abajo']}>
          <div class="tarjeta">
            <time class="fecha chico" datetime={h.fecha}>
              {h.fecha.length > 4 ? fechaCorta(h.fecha) : h.fecha}
            </time>
            <p class="titulo">{h.titulo}</p>
            {h.detalle && <p class="detalle chico">{h.detalle}</p>}
            {h.fuentes && h.fuentes.length > 0 && (
              <p class="fuente chico">
                {h.fuentes.slice(0, 2).map((f, j) => (
                  <>
                    {j > 0 && ' · '}
                    <a href={f.url} rel="external nofollow">
                      {f.titulo ? (f.titulo.length > 48 ? `${f.titulo.slice(0, 46)}…` : f.titulo) : 'fuente'}
                    </a>
                  </>
                ))}
              </p>
            )}
          </div>
          <span class="punto" aria-hidden="true" />
          <span class="anio" aria-hidden="true">
            {anioDe(h.fecha)}
          </span>
        </li>
      ))
    }
  </ol>
  <p class="chico ayuda">Deslizá de lado para recorrer los hitos; cada uno lleva su fuente.</p>
</div>

<style>
  .hitos {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    padding: var(--e-2) 0 var(--e-1);
    -webkit-overflow-scrolling: touch;
  }
  .hitos:focus-visible {
    outline: 2px solid var(--acento);
    outline-offset: 2px;
  }
  .cinta {
    --alto-tarjeta: 9.5rem;
    list-style: none;
    margin: 0;
    padding: 0 var(--e-4);
    display: flex;
    gap: 0;
    position: relative;
    height: calc(var(--alto-tarjeta) * 2 + 3.2rem);
    width: max-content;
    min-width: 100%;
  }
  /* La línea, atravesando toda la cinta a media altura. */
  .cinta::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--alto-tarjeta) + 1.6rem);
    height: 2px;
    background: var(--borde-2);
  }
  .hito {
    position: relative;
    flex: 0 0 15rem;
    height: 100%;
    scroll-snap-align: start;
  }
  .punto {
    position: absolute;
    left: 50%;
    top: calc(var(--alto-tarjeta) + 1.6rem);
    width: 12px;
    height: 12px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--acento);
    border: 2px solid var(--fondo);
    box-shadow: 0 0 0 2px var(--borde-2);
  }
  .anio {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: var(--t-xs);
    color: var(--texto-3);
    font-variant-numeric: tabular-nums;
    background: var(--fondo);
    padding: 0 0.3rem;
  }
  .arriba .anio {
    top: calc(var(--alto-tarjeta) + 2.2rem);
  }
  .abajo .anio {
    top: calc(var(--alto-tarjeta) + 0.2rem);
  }
  .tarjeta {
    position: absolute;
    left: 0.4rem;
    right: 0.4rem;
    height: var(--alto-tarjeta);
    overflow: hidden;
    padding: var(--e-2) var(--e-3);
    background: var(--fondo-2);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }
  .arriba .tarjeta {
    top: 0;
  }
  .abajo .tarjeta {
    top: calc(var(--alto-tarjeta) + 3.2rem);
  }
  /* El conector vertical entre la tarjeta y el punto. */
  .tarjeta::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 2px;
    height: 1.6rem;
    background: var(--borde-2);
  }
  .arriba .tarjeta::after {
    bottom: -1.6rem;
  }
  .abajo .tarjeta::after {
    top: -1.6rem;
  }
  .fecha {
    color: var(--texto-3);
    display: block;
  }
  .titulo {
    margin: 0.15rem 0 0.25rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .detalle {
    margin: 0;
    color: var(--texto-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .fuente {
    margin: 0.2rem 0 0;
    color: var(--texto-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ayuda {
    margin: 0.3rem 0 0;
    color: var(--texto-3);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hitos {
      scroll-behavior: smooth;
    }
  }
</style>
