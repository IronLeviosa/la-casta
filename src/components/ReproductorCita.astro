---
/**
 * Escuchar la cita en la fuente, desde el segundo en que se dice.
 *
 * El tono es información. Una frase dicha con ironía, con enojo o entre risas no significa lo mismo
 * que leída en plano, y eso el texto no lo transmite. Con el audio arrancando en el momento exacto,
 * el lector juzga por su cuenta algo que ninguna transcripción le puede dar.
 *
 * **Nada de terceros se pide hasta que el lector hace clic.** Si el reproductor se cargara solo,
 * cada página de registro estaría llamando a SoundCloud o a YouTube por el solo hecho de existir, y
 * anunciándole a esas plataformas quién lee qué. El botón inserta el iframe recién al apretarlo, y
 * recién ahí carga el script de control de la plataforma.
 *
 * Ese script hace falta, y se aprendió a la fuerza. La primera versión le pasaba el segundo por la
 * URL del reproductor (`t=5061s`) y **SoundCloud lo ignora**: medido en la página publicada, un clic
 * en "escuchar desde 1:24:21" arrancaba desde el principio. Con la API del widget, `seekTo` sí va al
 * segundo, y además permite los ±15 s sin recargar el reproductor y mostrar por dónde va. YouTube sí
 * respeta `start=`, pero los saltos y la posición también salen de su API. Las dos se cargan al
 * hacer clic, nunca antes.
 */
interface Props {
  url: string;
  marcaTiempo?: string;
  /** Dónde empieza el contexto; si viene, el reproductor arranca ahí y no en la cita. */
  marcaContexto?: string;
  medio: string;
  urlNota?: string;
}
const { url, marcaTiempo, marcaContexto, medio, urlNota } = Astro.props;
const marcaInicio = marcaContexto ?? marcaTiempo;

/** "1:24:21" o "84:21" o "504" -> segundos. */
function aSegundos(m?: string): number {
  if (!m) return 0;
  const p = m.trim().split(':').map(Number);
  if (p.some((n) => Number.isNaN(n))) return 0;
  return p.length === 3 ? p[0] * 3600 + p[1] * 60 + p[2] : p.length === 2 ? p[0] * 60 + p[1] : p[0];
}
const inicio = aSegundos(marcaInicio);

const idYoutube = /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([\w-]{11})/.exec(url)?.[1];
const idSoundcloud = /soundcloud\.com\/tracks\/(\d+)/.exec(url)?.[1];
const esArchivo = /\.(mp3|m4a|wav|ogg|opus|mp4|webm)(\?|$)/i.test(url);
const tipo = idYoutube ? 'youtube' : idSoundcloud ? 'soundcloud' : esArchivo ? 'archivo' : null;
const plataforma = tipo === 'youtube' ? 'YouTube' : tipo === 'soundcloud' ? 'SoundCloud' : null;
---

{
  tipo && (
    <div
      class="reproductor"
      data-tipo={tipo}
      data-yt={idYoutube}
      data-sc={idSoundcloud}
      data-src={url}
      data-inicio={inicio}
      data-marca={marcaInicio}
    >
      <div class="controles">
        <button type="button" class="play">
          ▶ Escuchar{marcaInicio && ` desde ${marcaInicio}`}
        </button>
        {marcaContexto && marcaTiempo && marcaContexto !== marcaTiempo && (
          <span class="chico donde">arranca en el contexto; la cita empieza en {marcaTiempo}</span>
        )}
        <button type="button" class="salto" data-delta="-15" disabled aria-label="Retroceder 15 segundos">
          −15 s
        </button>
        <button type="button" class="salto" data-delta="15" disabled aria-label="Adelantar 15 segundos">
          +15 s
        </button>
        <output class="posicion chico" aria-live="off" hidden />
        <span class="chico donde">
          {medio}
          {urlNota && (
            <>
              {' · '}
              <a href={urlNota} rel="external nofollow">
                nota completa del medio
              </a>
            </>
          )}
        </span>
      </div>
      <div class="marco" />
      <p class="chico nota-carga">
        {plataforma
          ? `Al reproducir se carga el reproductor de ${plataforma}, que puede registrar la visita.`
          : 'El audio se descarga del sitio del medio al reproducir.'}
      </p>
    </div>
  )
}

<script>
  // Un script externo por plataforma, cargado una sola vez y solo cuando alguien apretó play.
  const cargados = new Map();
  function cargarScript(src) {
    if (!cargados.has(src)) {
      cargados.set(
        src,
        new Promise((res, rej) => {
          const s = document.createElement('script');
          s.src = src;
          s.async = true;
          s.onload = () => res();
          s.onerror = () => rej(new Error(`No se pudo cargar ${src}`));
          document.head.appendChild(s);
        }),
      );
    }
    return cargados.get(src);
  }

  // La API de YouTube avisa que está lista por un callback global, no por una promesa.
  let youtubeListo = null;
  function apiYoutube() {
    if (!youtubeListo) {
      youtubeListo = new Promise((res) => {
        if (window.YT && window.YT.Player) return res(window.YT);
        const previo = window.onYouTubeIframeAPIReady;
        window.onYouTubeIframeAPIReady = () => {
          if (typeof previo === 'function') previo();
          res(window.YT);
        };
        cargarScript('https://www.youtube.com/iframe_api').catch(() => {});
      });
    }
    return youtubeListo;
  }

  function formatear(seg) {
    seg = Math.max(0, Math.round(seg));
    const h = Math.floor(seg / 3600);
    const m = Math.floor((seg % 3600) / 60);
    const s = seg % 60;
    return (h ? `${h}:${String(m).padStart(2, '0')}` : String(m)) + `:${String(s).padStart(2, '0')}`;
  }

  function crearIframe(src, alto) {
    const f = document.createElement('iframe');
    f.src = src;
    f.allow = 'autoplay; encrypted-media';
    f.title = 'Reproductor de la fuente';
    f.height = String(alto);
    return f;
  }

  document.querySelectorAll('.reproductor').forEach((caja) => {
    const marco = caja.querySelector('.marco');
    const play = caja.querySelector('.play');
    const saltos = [...caja.querySelectorAll('.salto')];
    const posicion = caja.querySelector('.posicion');
    const tipo = caja.dataset.tipo;
    const inicio = Number(caja.dataset.inicio || 0);
    const marca = caja.dataset.marca || formatear(inicio);
    let control = null;
    let montando = null;

    const mostrar = (seg) => {
      posicion.textContent = formatear(seg);
      posicion.hidden = false;
    };
    const listo = () => {
      saltos.forEach((b) => (b.disabled = false));
      // El minuto de la cita no desaparece del botón: es el dato al que el lector quiere volver.
      play.textContent = `↺ Volver a ${marca}`;
    };

    async function montarArchivo() {
      const a = document.createElement('audio');
      a.controls = true;
      a.preload = 'none';
      a.src = caja.dataset.src;
      marco.replaceChildren(a);
      a.addEventListener('timeupdate', () => mostrar(a.currentTime));
      const ir = (seg) => {
        a.currentTime = Math.max(0, seg);
        a.play().catch(() => {});
      };
      ir(inicio);
      return { ir, desplazar: (delta) => ir(a.currentTime + delta) };
    }

    async function montarSoundcloud() {
      // Primero el script, después el iframe: si el widget carga antes de que exista quien lo
      // escuche, el evento READY se pierde y nunca se llega a hacer el salto.
      await cargarScript('https://w.soundcloud.com/player/api.js');
      const pista = encodeURIComponent(`https://api.soundcloud.com/tracks/${caja.dataset.sc}`);
      const f = crearIframe(
        `https://w.soundcloud.com/player/?url=${pista}&auto_play=true&visual=false&show_comments=false&show_teaser=false&hide_related=true`,
        120,
      );
      marco.replaceChildren(f);
      const SC = window.SC;
      const w = SC.Widget(f);
      const ms = inicio * 1000;
      let saltado = false;
      const saltarSiHaceFalta = () =>
        w.getPosition((p) => {
          if (!saltado && Math.abs(p - ms) > 2000) w.seekTo(ms);
          saltado = true;
        });
      w.bind(SC.Widget.Events.READY, () => {
        w.seekTo(ms);
        w.play();
      });
      // En celulares el autoplay suele estar bloqueado: el lector aprieta el play del widget, el
      // audio arranca desde cero, y acá se lo lleva al minuto de la cita.
      w.bind(SC.Widget.Events.PLAY, saltarSiHaceFalta);
      w.bind(SC.Widget.Events.PLAY_PROGRESS, (e) => mostrar(e.currentPosition / 1000));
      return {
        ir: (seg) => {
          saltado = true;
          w.seekTo(Math.max(0, seg) * 1000);
          w.play();
        },
        desplazar: (delta) => w.getPosition((p) => w.seekTo(Math.max(0, p + delta * 1000))),
      };
    }

    async function montarYoutube() {
      const f = crearIframe(
        `https://www.youtube-nocookie.com/embed/${caja.dataset.yt}?start=${inicio}&autoplay=1&enablejsapi=1&origin=${encodeURIComponent(location.origin)}`,
        240,
      );
      marco.replaceChildren(f);
      const YT = await apiYoutube();
      const p = await new Promise((res) => {
        const jugador = new YT.Player(f, { events: { onReady: () => res(jugador) } });
      });
      setInterval(() => {
        if (typeof p.getPlayerState === 'function' && p.getPlayerState() === 1) mostrar(p.getCurrentTime());
      }, 500);
      return {
        ir: (seg) => {
          p.seekTo(Math.max(0, seg), true);
          p.playVideo();
        },
        desplazar: (delta) => p.seekTo(Math.max(0, p.getCurrentTime() + delta), true),
      };
    }

    async function montar() {
      if (control) return control;
      if (!montando) {
        montando = (tipo === 'archivo' ? montarArchivo() : tipo === 'soundcloud' ? montarSoundcloud() : montarYoutube())
          .then((c) => {
            control = c;
            listo();
            return c;
          })
          .catch(() => {
            // Sin la API (bloqueada por una extensión, sin red), queda el reproductor pelado con el
            // minuto a la vista para buscarlo a mano.
            play.textContent = `Reproductor sin control externo: buscá el minuto ${marca} a mano`;
            play.disabled = true;
            montando = null;
            return null;
          });
      }
      return montando;
    }

    play.addEventListener('click', async () => {
      if (control) control.ir(inicio);
      else await montar();
    });
    saltos.forEach((b) =>
      b.addEventListener('click', () => {
        if (control) control.desplazar(Number(b.dataset.delta));
      }),
    );
  });
</script>

<style>
  .reproductor {
    margin: 0.4rem 0;
  }
  .controles {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .controles button {
    font: inherit;
    font-size: var(--t-xs);
    padding: 0.2em 0.6em;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    background: var(--fondo-2);
    color: inherit;
    cursor: pointer;
  }
  .controles button:hover:not(:disabled) {
    border-color: var(--texto-2);
  }
  .controles button:disabled {
    opacity: 0.45;
    cursor: default;
  }
  .posicion {
    font-variant-numeric: tabular-nums;
    color: var(--texto-2);
    min-width: 4ch;
  }
  .donde {
    color: var(--texto-2);
  }
  .marco {
    margin-top: 0.4rem;
  }
  .marco :global(iframe),
  .marco :global(audio) {
    width: 100%;
    max-width: 46rem;
    border: 0;
  }
  .nota-carga {
    color: var(--texto-3);
    margin: 0.2rem 0 0;
  }
</style>
