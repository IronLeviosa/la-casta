---
/** Línea de tiempo de hechos posteriores a una promesa: fecha, tipo, efecto (a favor / en contra / neutral). */
import { etiqueta, fechaCorta } from '../lib/formato';
import type { Promesa } from '../lib/tipos';
import FuentesList from './FuentesList.astro';
import BadgeEvidencia from './BadgeEvidencia.astro';

interface Props {
  hechos: Promesa['data']['evidencias'];
  /** Mostrar fuentes de cada hecho (página de permalink). */
  conFuentes?: boolean;
}
const { hechos, conFuentes = false } = Astro.props;
const CLASE: Record<'a_favor' | 'en_contra' | 'neutral', string> = {
  a_favor: 'insignia-verde',
  en_contra: 'insignia-rojo',
  neutral: '',
};
const ICONO: Record<'a_favor' | 'en_contra' | 'neutral', string> = { a_favor: '+', en_contra: '−', neutral: '·' };
---

{
  hechos.length === 0 ? (
    <p class="vacio">Todavía no hay hechos posteriores registrados.</p>
  ) : (
    <ol class="ev-lista">
      {hechos.map((h) => (
        <li class="ev-item">
          <time class="ev-fecha" datetime={h.fecha}>
            {fechaCorta(h.fecha)}
          </time>
          <div>
            <div class="insignias">
              <span class:list={['insignia', CLASE[h.efecto]]}>
                <span class="icono" aria-hidden="true">
                  {ICONO[h.efecto]}
                </span>
                <span>{etiqueta(h.efecto)}</span>
              </span>
              <span class="insignia">{etiqueta(h.tipo)}</span>
              <BadgeEvidencia nivel={h.evidencia.nivel} />
            </div>
            <p>{h.descripcion}</p>
            {conFuentes && <FuentesList fuentes={h.evidencia.fuentes} cadena={h.evidencia.cadena} nivel="h4" titulo="Fuentes del hecho" />}
          </div>
        </li>
      ))}
    </ol>
  )
}

<style>
  .ev-lista {
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--e-3);
    border-left: 2px solid var(--borde-2);
  }
  .ev-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--e-1) var(--e-3);
    padding: 0 0 var(--e-3) var(--e-2);
  }
  .ev-item p {
    margin: 0;
  }
  .ev-fecha {
    font-size: var(--t-sm);
    color: var(--texto-2);
    white-space: nowrap;
  }
  @media (min-width: 40rem) {
    .ev-item {
      grid-template-columns: 6rem 1fr;
    }
  }
</style>
