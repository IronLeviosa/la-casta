---
/**
 * Sustancia del discurso: barras apiladas por clase con n e intervalo de
 * confianza, índice de evasión con subtipos de Bull, ratio de mentiras con
 * dos denominadores. Con muestra insuficiente muestra qué falta.
 */
import { decimal, etiqueta, numero, porcentaje } from '../lib/formato';
import { CLASES_SUSTANCIA, MINIMO_INTERVENCIONES, MINIMO_PALABRAS, type ResumenSustancia } from '../lib/sustancia';

interface Props {
  resumen: ResumenSustancia;
}
const { resumen: r } = Astro.props;
const COLOR: Record<string, string> = {
  hecho_verificable: 'var(--clase-hecho)',
  propuesta_concreta: 'var(--clase-propuesta)',
  argumento: 'var(--clase-argumento)',
  posicion: 'var(--clase-posicion)',
  retorica: 'var(--clase-retorica)',
  ataque: 'var(--clase-ataque)',
  evasion: 'var(--clase-evasion)',
  otro: 'var(--clase-otro)',
};
const visibles = r.distribucion.filter((d) => d.palabras > 0);
---

<div class="sustancia">
  {
    !r.suficiente ? (
      <div class="vacio">
        <p>
          <strong>Muestra insuficiente.</strong> El índice se publica recién con {MINIMO_INTERVENCIONES} intervenciones y{' '}
          {numero(MINIMO_PALABRAS)} palabras transcritas y clasificadas por dos modelos con acuerdo suficiente.
        </p>
        <p class="chico">
          Hay {r.nIntervenciones} {r.nIntervenciones === 1 ? 'intervención' : 'intervenciones'} ({numero(r.palabras)} palabras).
          {r.faltan.intervenciones > 0 && ` Faltan ${r.faltan.intervenciones} intervenciones.`}
          {r.faltan.palabras > 0 && ` Faltan ${numero(r.faltan.palabras)} palabras.`}
        </p>
      </div>
    ) : (
      <>
        <p class="chico">
          {r.nIntervenciones} intervenciones · {numero(r.palabras)} palabras · acuerdo entre etiquetadores (kappa promedio){' '}
          {decimal(r.kappaPromedio, 2)}. Clasificación a ciegas por dos modelos según la rúbrica de{' '}
          <a href="/metodologia/">metodología</a>.
        </p>
        <h4>Distribución por clase (palabras)</h4>
        <div class="barras" role="img" aria-label={visibles.map((d) => `${etiqueta(d.clase)} ${porcentaje(d.fraccion)}`).join(', ')}>
          {visibles.map((d) => (
            <span
              class="barra"
              style={`flex-grow:${Math.max(d.fraccion * 1000, 1)};background:${COLOR[d.clase]}`}
              title={`${etiqueta(d.clase)}: ${porcentaje(d.fraccion)} (${numero(d.palabras)} palabras)`}
            />
          ))}
        </div>
        <ul class="leyenda">
          {visibles.map((d) => (
            <li>
              <span class="muestra" style={`background:${COLOR[d.clase]}`} aria-hidden="true" />
              {etiqueta(d.clase)}: {porcentaje(d.fraccion)} <span class="muy-chico">({numero(d.palabras)})</span>
              {CLASES_SUSTANCIA.includes(d.clase) && <span class="muy-chico"> · cuenta como sustancia</span>}
            </li>
          ))}
        </ul>
        <p>
          <strong>Índice de sustancia:</strong> {porcentaje(r.indice)}{' '}
          <span class="chico">
            (IC 95 % bootstrap: {porcentaje(r.ic.inferior)} – {porcentaje(r.ic.superior)})
          </span>
        </p>
        <p class="muy-chico">
          Fracción de palabras en hechos verificables, propuestas concretas (ponderadas por especificidad) y argumentos.
          Nunca se muestra sin la distribución completa.
        </p>

        <h4>Evasión en entrevistas</h4>
        {r.evasion ? (
          <>
            <p>
              {r.evasion.preguntas} preguntas en {r.evasion.nIntervenciones} intervenciones con preguntas ·{' '}
              respondidas {r.evasion.respondidas}, parciales {r.evasion.parciales}, no respondidas {r.evasion.noRespondidas}.
            </p>
            <p>
              <strong>Índice de evasión:</strong> {porcentaje(r.evasion.indice)}{' '}
              <span class="chico">
                (IC 95 %: {porcentaje(r.evasion.ic.inferior)} – {porcentaje(r.evasion.ic.superior)})
              </span>
            </p>
            {r.evasion.subtipos.length > 0 && (
              <ul class="chico">
                {r.evasion.subtipos.map((s) => (
                  <li>
                    {etiqueta(s.subtipo)}: {s.n}
                  </li>
                ))}
              </ul>
            )}
            <p class="muy-chico">Tipología de no-respuesta de Bull y Mayer (1993).</p>
          </>
        ) : (
          <p class="vacio">No hay intervenciones con preguntas.</p>
        )}

        <h4>Ratio de afirmaciones falsas</h4>
        {r.mentiras.nIntervenciones > 0 && r.mentiras.chequeos > 0 ? (
          <>
            <p>
              Sobre {r.mentiras.nIntervenciones} intervenciones chequeadas exhaustivamente ({numero(r.mentiras.palabras)} palabras,{' '}
              {r.mentiras.chequeos} afirmaciones chequeadas): <strong>{r.mentiras.falsos}</strong> falsas.
            </p>
            <ul>
              <li>
                Por cada 1000 palabras: <strong>{decimal(r.mentiras.porMilPalabras, 2)}</strong>
              </li>
              <li>
                Por afirmación chequeada: <strong>{porcentaje(r.mentiras.porAfirmacion)}</strong>
              </li>
            </ul>
            <p class="muy-chico">
              Solo entran intervenciones donde todas las oraciones con hechos verificables pasaron por el Veracímetro, para
              evitar el sesgo de elegir solo las llamativas. Un «falso» exige documento oficial en contra.
            </p>
          </>
        ) : (
          <p class="vacio">Todavía no hay intervenciones chequeadas exhaustivamente.</p>
        )}
      </>
    )
  }
</div>

<style>
  .barras {
    display: flex;
    height: 1.4rem;
    border-radius: var(--radio);
    overflow: hidden;
    border: 1px solid var(--borde-2);
    margin-bottom: var(--e-2);
  }
  .barra {
    display: block;
    min-width: 2px;
  }
  .leyenda {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--e-3);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: var(--e-1) var(--e-3);
    font-size: var(--t-sm);
  }
  .muestra {
    display: inline-block;
    width: 0.9em;
    height: 0.9em;
    border-radius: 2px;
    margin-right: 0.4em;
    vertical-align: -0.1em;
    border: 1px solid var(--borde-2);
  }
</style>
