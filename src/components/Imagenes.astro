---
/**
 * Imágenes de un registro, cada una con pie, crédito y licencia.
 *
 * Solo entran imágenes con licencia libre (Presidencia y otros organismos cuando su página lo
 * declara, Wikimedia Commons, dominio público) o recortes de documentos oficiales. Las fotos de
 * los diarios no: son obra con derechos y el sitio, que vive de verificar a otros, no puede
 * permitirse ese flanco. El crédito y el enlace a la licencia van siempre, porque las licencias
 * libres lo piden.
 */
import { ruta } from '../lib/ruta';

interface Imagen {
  url: string;
  alt: string;
  pie?: string;
  credito: string;
  licencia: string;
  licencia_url?: string;
  pagina?: string;
}
interface Props {
  imagenes?: readonly Imagen[] | null;
}
const imagenes = Astro.props.imagenes ?? [];
---

{
  imagenes.length > 0 && (
    <div class="imagenes">
      {imagenes.map((im) => (
        <figure class="imagen">
          <img src={ruta(im.url)} alt={im.alt} loading="lazy" decoding="async" />
          <figcaption class="chico">
            {im.pie && <span class="pie">{im.pie} </span>}
            <span class="credito">
              Foto: {im.credito} ·{' '}
              {im.licencia_url ? (
                <a href={im.licencia_url} rel="license external nofollow">
                  {im.licencia}
                </a>
              ) : (
                im.licencia
              )}
              {im.pagina && (
                <>
                  {' · '}
                  <a href={im.pagina} rel="external nofollow">
                    original
                  </a>
                </>
              )}
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  )
}

<style>
  .imagenes {
    display: grid;
    gap: var(--e-3);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    max-width: 46rem;
    margin: var(--e-3) 0;
  }
  .imagen {
    margin: 0;
  }
  .imagen img {
    width: 100%;
    height: auto;
    border-radius: var(--radio);
    border: 1px solid var(--borde);
    display: block;
  }
  figcaption {
    margin-top: 0.3rem;
    color: var(--texto-2);
  }
  .credito {
    color: var(--texto-3);
  }
</style>
