---
/** Giro: dos citas lado a lado (apiladas en móvil) con insignias de cambio y explicación. */
import { etiqueta, fechaLarga } from '../lib/formato';
import { urlDe } from '../lib/permalinks';
import type { Declaracion, Giro } from '../lib/tipos';
import Cita from './Cita.astro';
import BadgeEvidencia from './BadgeEvidencia.astro';
import BadgeDiversidad from './BadgeDiversidad.astro';
import { ruta } from '../lib/ruta';
import { servibles } from '../lib/contenido';

interface Props {
  giro: Giro;
  antes: Declaracion;
  despues: Declaracion;
  tema?: { id: string; nombre: string };
  /** true en la página del permalink: muestra el análisis completo. */
  completo?: boolean;
}
const { giro, antes, despues, tema, completo = false } = Astro.props;
const g = giro.data;
const CLASE_CAMBIO: Record<typeof g.cambio, string> = {
  sin_cambio: 'insignia-verde',
  cambio_parcial: 'insignia-amarillo',
  cambio_total: 'insignia-rojo',
};
const ICONO_CAMBIO: Record<typeof g.cambio, string> = { sin_cambio: '=', cambio_parcial: '≈', cambio_total: '≠' };
const CLASE_EXPL: Record<typeof g.explicacion, string> = {
  reconocido_explicitamente: 'insignia-verde',
  justificado_por_contexto: 'insignia-amarillo',
  sin_explicacion: 'insignia-rojo',
};
const href = urlDe('giros', giro.id);

/**
 * Promesas del mismo politico sobre el mismo tema.
 *
 * El vinculo se deriva, no se guarda en el registro: un giro y una promesa ya comparten `politico`
 * y `tema`, asi que guardarlo de nuevo solo agregaria una copia que se puede desincronizar. Y al
 * derivarlo, el enlace aparece igual para todos los politicos sin que nadie tenga que acordarse de
 * cargarlo, que es justo lo que la Regla 0 pide de una regla editorial.
 *
 * Existe porque un giro sobre impuestos y una promesa de no subir impuestos son dos lecturas del
 * mismo hecho: sin el enlace, el lector puede creer que el sitio califico la frase y se perdio lo
 * que efectivamente paso.
 *
 * Cuenta las promesas en tier `probable` (existen, y el lector tiene que saberlo) pero no muestra
 * su veredicto: la ficha dice que lo probable no se muestra en la página publicada, y un
 * «Incumplida (en probable)» repetido en cuatro tarjetas era exactamente eso (ficha de Astori,
 * 2026-09-17). La tarjeta lleva una sola línea con el conteo y el enlace a la sección de promesas
 * de la ficha; la página del giro tiene su propia sección «Y qué pasó con lo que prometió» y no
 * repite la línea.
 */
const promesasRelacionadas = (await servibles('promesas'))
  .filter((pr) => pr.data.politico.id === g.politico.id && pr.data.tema.id === g.tema.id)
  .map((pr) => {
    // El texto de la promesa suele traer, despues del primer punto, la explicacion de como se
    // descompuso una promesa compuesta. Eso es util en la ficha de la promesa y ruido en el enlace,
    // asi que aca va solo la primera oracion. El enlace lleva al texto entero.
    const primera = pr.data.texto.match(/^[^.]+\./)?.[0] ?? pr.data.texto;
    return { id: pr.id, etiqueta: primera.replace(/\.$/, ''), estado: pr.data.estado, probable: pr.data.revision.tier === 'probable' };
  });
const promesasPublicadas = promesasRelacionadas.filter((pr) => !pr.probable);
const promesasEnProbable = promesasRelacionadas.length - promesasPublicadas.length;
const fuentesTodas = [...antes.data.evidencia.fuentes, ...despues.data.evidencia.fuentes];
// Con una punta reportada, el aviso de un solo grupo aplica al giro entero; con las dos textuales, no.
const nivelGiro =
  antes.data.evidencia.nivel === 'reportado' || despues.data.evidencia.nivel === 'reportado' ? 'reportado' : antes.data.evidencia.nivel;
---

<article class="tarjeta giro" id={giro.id.replaceAll('/', '--')}>
  <div class="insignias">
    <span class:list={['insignia', CLASE_CAMBIO[g.cambio]]}>
      <span class="icono" aria-hidden="true">{ICONO_CAMBIO[g.cambio]}</span>
      <span>Cambio: {etiqueta(g.cambio)}</span>
    </span>
    {
      /* Sin cambio no hay nada que explicar: el chip «Sin explicación» se leía como un reproche. */
      g.cambio !== 'sin_cambio' && (
        <span class:list={['insignia', CLASE_EXPL[g.explicacion]]}>
          <span>Explicación: {etiqueta(g.explicacion)}</span>
        </span>
      )
    }
    {tema && <a class="insignia" href={ruta(`/temas/${tema.id}/`)}>{tema.nombre}</a>}
    <BadgeDiversidad fuentes={fuentesTodas} nivel={nivelGiro} />
  </div>
  <div class="giro-citas dos-columnas">
    <div>
      <h4 class="giro-lado">
        Antes · <time datetime={antes.data.fecha}>{fechaLarga(antes.data.fecha)}</time>
      </h4>
      <Cita
        cita={antes.data.cita}
        cargo={antes.data.cargo_en_ese_momento}
        contexto={antes.data.contexto}
        href={urlDe('declaraciones', antes.id)}
        compacta
      />
      <BadgeEvidencia nivel={antes.data.evidencia.nivel} />
    </div>
    <div>
      <h4 class="giro-lado">
        Después · <time datetime={despues.data.fecha}>{fechaLarga(despues.data.fecha)}</time>
      </h4>
      <Cita
        cita={despues.data.cita}
        cargo={despues.data.cargo_en_ese_momento}
        contexto={despues.data.contexto}
        href={urlDe('declaraciones', despues.id)}
        compacta
      />
      <BadgeEvidencia nivel={despues.data.evidencia.nivel} />
    </div>
  </div>
  {
    !completo && promesasRelacionadas.length > 0 && (
      <p class="chico giro-promesa">
        Sobre este tema hay{' '}
        <a href={ruta(`/politicos/${g.politico.id}/#promesas`)}>
          {promesasPublicadas.length === 1 ? 'una promesa de campaña' : `${promesasPublicadas.length} promesas de campaña`} con su propio seguimiento
        </a>
        {promesasEnProbable > 0 && ` (y ${promesasEnProbable === 1 ? 'una más' : `${promesasEnProbable} más`} en probable, todavía sin la evidencia completa)`}
        . Un giro califica si cambió lo que dijo; una promesa, si hizo lo que prometió.
      </p>
    )
  }
  {
    completo ? (
      <div class="giro-analisis">
        <h3>Análisis</h3>
        <p>{g.analisis}</p>
      </div>
    ) : (
      <p class="chico giro-resumen">
        {g.analisis.length > 260 ? `${g.analisis.slice(0, 260).trimEnd()}…` : g.analisis} <a href={href}>Ver giro completo</a>
      </p>
    )
  }
</article>

<style>
  .giro-lado {
    margin: 0 0 var(--e-2);
    font-size: var(--t-sm);
    color: var(--texto-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .giro-resumen {
    margin-top: var(--e-3);
  }
  .giro-promesa {
    margin-top: var(--e-3);
    padding: var(--e-2) var(--e-3);
    border-left: 3px solid var(--borde);
    background: var(--fondo-2);
    color: var(--texto-2);
  }
</style>
