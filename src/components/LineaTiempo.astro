---
/**
 * Línea de tiempo horizontal y a escala: el eje es el tiempo real, así que 1930 queda lejos de
 * 2000 y 2000 cerca de 2010. Cada ítem es un punto sobre el eje con su rótulo (cuatro filas
 * alternadas, solo donde entra sin pisar a otro) y una tarjeta al pasar el cursor o al enfocarlo
 * con el teclado (fecha, título, dos líneas de detalle, de dónde sale); el clic lleva a la página
 * del registro o, en un hito, al documento. Debajo no va nada más: la información ya está en la
 * cinta. Para lectores de pantalla queda la misma lista, oculta a la vista.
 *
 * El zoom se elige solo: se prueban escalas crecientes (píxeles por año) hasta que al menos tres
 * de cada cuatro puntos tienen rótulo sin pisar a otro de su fila. Los años del eje van en una
 * fila propia. Sin JavaScript: la tarjeta es CSS (`:hover`, `:focus`) y el filtro por tema es el
 * `:target` de siempre.
 *
 * Un lector señaló, con capturas, las tres versiones anteriores: la vertical (una página de
 * texto), la cinta equidistante (70 años a la misma distancia que 10) y la que repetía debajo,
 * en desplegables por año, lo que la cinta ya mostraba, con enlaces que bajaban a esa lista en
 * vez de ir al registro. Esta es la cuarta.
 */
import { anio, fechaCorta } from '../lib/formato';
import { ruta } from '../lib/ruta';

export interface ItemLinea {
  /** YYYY, YYYY-MM o YYYY-MM-DD. */
  fecha: string;
  titulo: string;
  /** Adónde lleva el clic: la página del registro. Si falta, se usa la primera fuente. */
  href?: string;
  /** Categoría para la leyenda (tema de una declaración, tipo de un hito); `color` fija el índice
   *  de la paleta (1 a 10) cuando la categoría tiene color fijo en todo el sitio. */
  tema?: { id: string; nombre: string; color?: number };
  resumen?: string;
  detalle?: string;
  etiquetas?: { texto: string; clase?: string }[];
  fuentes?: { url: string; titulo?: string }[];
}

interface Props {
  items: ItemLinea[];
  /** Id único en la página (anclas del filtro por tema). */
  id: string;
  /** Nombre de la persona o empresa, para el rótulo accesible. */
  de?: string;
  /** Con más ítems que esto, no se rotula ninguno: quedan los puntos con su tarjeta. */
  maxRotulos?: number;
  /** Rótulo de la leyenda («Temas», «Tipo de hito»). */
  rotuloFiltro?: string;
}
const { items, id, de, maxRotulos = 30, rotuloFiltro = 'Temas' } = Astro.props;

const completar = (f: string) => (f.length === 4 ? `${f}-01-01` : f.length === 7 ? `${f}-01` : f);
const dia = (f: string) => Math.floor(Date.parse(completar(f)) / 86_400_000);
const ordenados = [...items].filter((it) => !Number.isNaN(dia(it.fecha))).sort((a, b) => a.fecha.localeCompare(b.fecha));

const anioMin = ordenados.length ? anio(completar(ordenados[0].fecha)) : new Date().getFullYear();
const anioMax = ordenados.length ? anio(completar(ordenados.at(-1)!.fecha)) : anioMin;
// El eje arranca en el 1 de enero del primer año y termina en el 31 de diciembre del último, con
// medio año de aire a cada lado para que el primer y el último punto no queden en el borde.
const ini = dia(`${anioMin}-01-01`) - 182;
const fin = dia(`${anioMax}-12-31`) + 182;
const pct = (f: string) => ((dia(f) - ini) / (fin - ini)) * 100;
const anios = anioMax - anioMin + 1;

/* Zoom: píxeles por año. Un rótulo mide 10rem (160 px) y necesita 176 px libres respecto del
   anterior de su fila (hay cuatro filas). Se prueba de menos a más y se toma la primera escala
   con la que al menos el 75 % de los puntos entra rotulado; si ninguna alcanza, la mayor. */
const ANCHO_ROTULO_PX = 176;
const FILAS = 4;
const conRotulos = ordenados.length <= maxRotulos;
/* Cerca de los bordes de la cinta el rótulo no se centra en el punto: se ancla a él y crece hacia
   adentro. El chequeo de lugar usa el intervalo real que ocupa cada rótulo, no ±88 px alrededor
   del punto: con el centrado supuesto, un rótulo anclado a la derecha pisaba al anterior de su fila. */
const BORDE_PX = 170;
function intervaloRotulo(x: number, anchoTotal: number): [number, number] {
  if (x < BORDE_PX) return [x, x + ANCHO_ROTULO_PX];
  if (anchoTotal - x < BORDE_PX) return [x - ANCHO_ROTULO_PX, x];
  return [x - ANCHO_ROTULO_PX / 2, x + ANCHO_ROTULO_PX / 2];
}
function rotularCon(pxPorAnio: number): boolean[] {
  const anchoTotal = anios * pxPorAnio;
  const finPorFila = Array.from({ length: FILAS }, () => -Infinity);
  return ordenados.map((it, i) => {
    const x = (pct(it.fecha) / 100) * anchoTotal;
    const fila = i % FILAS;
    const [ini, fin] = intervaloRotulo(x, anchoTotal);
    const cabe = conRotulos && ini >= finPorFila[fila];
    if (cabe) finPorFila[fila] = fin;
    return cabe;
  });
}
const ESCALAS = [24, 48, 96, 160, 240, 360];
let pxPorAnio = ESCALAS[0];
let rotulado: boolean[] = rotularCon(pxPorAnio);
if (conRotulos) {
  for (const escala of ESCALAS) {
    const r = rotularCon(escala);
    pxPorAnio = escala;
    rotulado = r;
    if (r.filter(Boolean).length >= Math.ceil(ordenados.length * 0.75)) break;
  }
}
/* Sin rótulos (muchos puntos), el zoom se elige para que los puntos no se pisen: van en tres filas
   alternadas y se sube la escala hasta que tres de cada cuatro tienen 14 px libres respecto del
   anterior de su fila. Ciento diez declaraciones en cinco años eran una mancha de un solo color. */
const FILAS_PUNTOS = 3;
const ANCHO_PUNTO_PX = 14;
function separadosCon(px: number): number {
  const ultimoPorFila = Array.from({ length: FILAS_PUNTOS }, () => -Infinity);
  let ok = 0;
  ordenados.forEach((it, i) => {
    const x = (pct(it.fecha) / 100) * anios * px;
    const fila = i % FILAS_PUNTOS;
    if (x - ultimoPorFila[fila] >= ANCHO_PUNTO_PX) ok++;
    ultimoPorFila[fila] = x;
  });
  return ok;
}
if (!conRotulos) {
  for (const escala of ESCALAS) {
    pxPorAnio = escala;
    if (separadosCon(escala) >= Math.ceil(ordenados.length * 0.75)) break;
  }
}
const nRotulados = rotulado.filter(Boolean).length;
const anchoMinimoPx = Math.round(anios * pxPorAnio);
const paso = pxPorAnio >= 60 ? 1 : anios <= 40 ? 5 : 10;
const marcas: number[] = [];
for (let a = Math.ceil(anioMin / paso) * paso; a <= anioMax; a += paso) marcas.push(a);
if (!marcas.includes(anioMin)) marcas.unshift(anioMin);

const temas = new Map<string, string>();
const cuentaTema = new Map<string, number>();
const colorFijo = new Map<string, number>();
for (const it of ordenados) {
  if (!it.tema) continue;
  temas.set(it.tema.id, it.tema.nombre);
  cuentaTema.set(it.tema.id, (cuentaTema.get(it.tema.id) ?? 0) + 1);
  if (it.tema.color) colorFijo.set(it.tema.id, it.tema.color);
}
const indiceTema = new Map([...temas.keys()].map((t, i) => [t, colorFijo.get(t) ?? (i % 10) + 1]));
const slugTema = (t: string) => t.replaceAll('/', '--');
const anclaTema = (t: string) => `${id}-tema-${slugTema(t)}`;
/* Sin JavaScript, el filtro por tema es el `:target` del enlace (un tema por vez). Con JavaScript
   (clase `js` en la raíz) manda el script de abajo: hover atenúa el resto, clic fija, y se pueden
   fijar varios temas para ver un grupo elegido. */
const css = [...temas.keys()]
  .map(
    (t) =>
      `#${id}:not(.js):has(#${anclaTema(t)}:target) [data-tema]:not([data-tema="${t}"]){display:none}` +
      `#${id}:not(.js):has(#${anclaTema(t)}:target) .lt-filtro a[href="#${anclaTema(t)}"]{font-weight:700;border-color:var(--acento)}`,
  )
  .join('\n');

const fechaTexto = (f: string) => (f.length === 4 ? f : f.length === 7 ? `${f.slice(5)}/${f.slice(0, 4)}` : fechaCorta(f));
const pantallas = Math.max(1, Math.round(anchoMinimoPx / 900));
const destino = (it: ItemLinea) => it.href ?? it.fuentes?.[0]?.url;
const externo = (it: ItemLinea) => !it.href && !!it.fuentes?.[0]?.url;
const detalleDe = (it: ItemLinea) => it.detalle ?? it.resumen;
const dominio = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
};
const origenDe = (it: ItemLinea) => (it.fuentes && it.fuentes.length ? it.fuentes[0].titulo ?? dominio(it.fuentes[0].url) : undefined);
/* La tarjeta mide 19rem (304 px) y se centra en el punto; cerca de los bordes de la cinta se
   ancla al punto para no salirse (lo que se sale por la izquierda no se puede desplazar). */
const xPx = (it: ItemLinea) => (pct(it.fecha) / 100) * anchoMinimoPx;
const borde = (it: ItemLinea) => (xPx(it) < BORDE_PX ? 'borde-izq' : anchoMinimoPx - xPx(it) < BORDE_PX ? 'borde-der' : '');
---

<div class="lt" id={id} style={`--ancho-min: ${anchoMinimoPx}px`}>
  {
    temas.size > 1 && (
      <nav class="lt-filtro" aria-label={`Filtrar por ${rotuloFiltro.toLowerCase()}`}>
        <span class="chico">{rotuloFiltro}:</span>
        <a href={`#${id}`} class="lt-todos">Todos</a>
        {[...temas.entries()].map(([tid, nombre]) => (
          <a
            href={`#${anclaTema(tid)}`}
            class={`lt-c${indiceTema.get(tid)}`}
            data-tema={tid}
            title="Pasá el cursor para resaltar este tema; clic para fijarlo (se pueden fijar varios)"
          >
            {nombre} <span class="lt-n">{cuentaTema.get(tid)}</span>
          </a>
        ))}
        <button type="button" class="lt-reset" hidden>
          ✕ quitar filtros
        </button>
      </nav>
    )
  }
  {[...temas.keys()].map((t) => <span id={anclaTema(t)} class="lt-ancla" aria-hidden="true" />)}
  {css && <style set:html={css} />}

  <div class="lt-scroll" role="region" aria-label={de ? `Línea de tiempo de ${de}` : 'Línea de tiempo'} tabindex="0">
    <div class="lt-cinta">
      <div class:list={['lt-eje', conRotulos ? 'con-rotulos' : 'sin-rotulos']}>
        <div class="lt-linea" />
        {
          ordenados.map((it, i) => {
            const Tag = destino(it) ? 'a' : 'span';
            return (
              <Tag
                class:list={['lt-punto', `lt-c${it.tema ? indiceTema.get(it.tema.id) : 0}`, rotulado[i] ? `pos-${i % FILAS}` : '', conRotulos ? '' : `fila-${i % FILAS_PUNTOS}`, borde(it)]}
                style={`left: ${pct(it.fecha)}%`}
                href={destino(it)}
                rel={externo(it) ? 'external nofollow' : undefined}
                tabindex={destino(it) ? undefined : 0}
                data-tema={it.tema?.id}
                aria-label={`${fechaTexto(it.fecha)}: ${it.titulo}`}
              >
                <span class="lt-dot" />
                {rotulado[i] && (
                  <span class="lt-rotulo" aria-hidden="true">
                    <span class="lt-rotulo-fecha">{fechaTexto(it.fecha)}</span>
                    <span class="lt-rotulo-titulo">{it.titulo}</span>
                  </span>
                )}
                <span class="lt-tarjeta" role="tooltip">
                  <span class="lt-tarjeta-fecha">{fechaTexto(it.fecha)}{it.tema ? ` · ${it.tema.nombre}` : ''}</span>
                  <span class="lt-tarjeta-titulo">{it.titulo}</span>
                  {detalleDe(it) && <span class="lt-tarjeta-detalle">{detalleDe(it)}</span>}
                  {it.etiquetas && it.etiquetas.length > 0 && <span class="lt-tarjeta-origen">{it.etiquetas.map((e) => e.texto).join(' · ')}</span>}
                  {origenDe(it) && <span class="lt-tarjeta-origen">{externo(it) ? 'Documento: ' : 'Fuente: '}{origenDe(it)}</span>}
                  {destino(it) && <span class="lt-tarjeta-accion">{externo(it) ? 'Clic: abrir el documento' : 'Clic: ver el registro'}</span>}
                </span>
              </Tag>
            );
          })
        }
      </div>
      <div class="lt-anios" aria-hidden="true">
        {
          marcas.map((a) => (
            <span class="lt-marca" style={`left: ${pct(`${a}-01-01`)}%`}>
              <span class="lt-tick" />
              <span class="lt-anio-rotulo">{a}</span>
            </span>
          ))
        }
      </div>
    </div>
  </div>
  <p class="muy-chico lt-nota">
    Eje a escala: la distancia entre dos puntos es la distancia en el tiempo
    {pantallas > 1 ? `; la cinta ocupa unas ${pantallas} pantallas, arranca por lo más reciente y se desplaza de lado` : ''}.
    Al pasar el cursor por un punto aparece su tarjeta; el clic abre el registro o el documento.
    {!conRotulos ? ' Son muchos puntos para rotular.' : nRotulados === ordenados.length ? '' : ` Llevan rótulo ${nRotulados} de ${ordenados.length} puntos.`}
  </p>

  <ol class="visualmente-oculto">
    {
      ordenados.map((it) => (
        <li data-tema={it.tema?.id}>
          {fechaTexto(it.fecha)}: {destino(it) ? <a href={destino(it)}>{it.titulo}</a> : it.titulo}
          {detalleDe(it) ? ` ${detalleDe(it)}` : ''}
        </li>
      ))
    }
  </ol>
</div>

<style>
  .lt {
    margin: var(--e-3) 0;
  }
  .lt-filtro {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
    margin-bottom: var(--e-2);
  }
  .lt-filtro a {
    font-size: var(--t-sm);
    border: 1px solid var(--borde);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    text-decoration: none;
  }
  .lt-ancla {
    position: absolute;
  }
  .lt-scroll {
    overflow-x: auto;
    padding-bottom: 0.25rem;
    /* Sin JavaScript: con direction rtl el desplazamiento arranca por el extremo reciente, que es
       el que el lector busca primero; la cinta adentro vuelve a ltr y se dibuja normal. */
    direction: rtl;
  }
  .lt-cinta {
    direction: ltr;
    /* A escala: el ancho mínimo lo fija el zoom elegido; un tramo corto se estira al ancho disponible. */
    min-width: var(--ancho-min);
    width: 100%;
    /* Margen interno para que el primer y el último rótulo no salgan de la cinta. */
    padding: 0 5rem;
    box-sizing: border-box;
  }
  .lt-eje {
    position: relative;
    /* El alto deja lugar a la tarjeta, que se centra en el punto: el contenedor con desplazamiento
       recorta lo que se sale por arriba o por abajo. */
    height: 12rem;
    --eje: 50%;
  }
  .lt-eje.con-rotulos {
    height: 16rem;
  }
  .lt-linea {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--eje);
    height: 2px;
    background: var(--borde);
  }
  .lt-anios {
    position: relative;
    height: 1.6rem;
    border-top: 1px solid var(--borde);
  }
  .lt-marca {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    text-align: center;
  }
  .lt-tick {
    display: block;
    width: 1px;
    height: 0.4rem;
    margin: 0 auto;
    background: var(--texto-3);
  }
  .lt-anio-rotulo {
    display: block;
    font-size: var(--t-sm);
    color: var(--texto-3);
  }
  .lt-punto {
    position: absolute;
    top: var(--eje);
    transform: translate(-50%, calc(-50% + var(--dy, 0rem)));
    text-decoration: none;
    color: inherit;
  }
  /* Sin rótulos: tres filas de puntos alrededor del eje para que los cercanos no se tapen. */
  .lt-punto.fila-0 {
    --dy: -0.9rem;
  }
  .lt-punto.fila-2 {
    --dy: 0.9rem;
  }
  .lt-punto:hover,
  .lt-punto:focus {
    z-index: 10;
  }
  .lt-dot {
    display: block;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--c, var(--acento));
    border: 2px solid var(--fondo);
    box-shadow: 0 0 0 1px var(--c, var(--acento));
  }
  .lt-punto:hover .lt-dot,
  .lt-punto:focus .lt-dot {
    transform: scale(1.4);
  }
  .lt-rotulo {
    position: absolute;
    left: 50%;
    width: 10rem;
    transform: translateX(-50%);
    font-size: var(--t-sm);
    line-height: 1.25;
    text-align: center;
  }
  .lt-rotulo-fecha {
    display: block;
    color: var(--texto-3);
    font-size: 0.8em;
  }
  .lt-rotulo-titulo {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Cuatro filas: dos arriba y dos abajo del eje; las lejanas llevan una guía hasta el punto. */
  .pos-0 .lt-rotulo {
    bottom: 1.1rem;
  }
  .pos-1 .lt-rotulo {
    top: 1.1rem;
  }
  .pos-2 .lt-rotulo {
    bottom: 4.6rem;
  }
  .pos-3 .lt-rotulo {
    top: 4.6rem;
  }
  .pos-2 .lt-dot::after,
  .pos-3 .lt-dot::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 1px;
    height: 3.4rem;
    background: var(--borde);
    z-index: -1;
  }
  .pos-2 .lt-dot::after {
    bottom: 100%;
  }
  .pos-3 .lt-dot::after {
    top: 100%;
  }
  .borde-izq .lt-rotulo {
    left: 0;
    transform: none;
    text-align: left;
  }
  .borde-der .lt-rotulo {
    left: auto;
    right: 0;
    transform: none;
    text-align: right;
  }
  /* La tarjeta: aparece sobre el punto al pasar el cursor o al enfocarlo; tapa los rótulos vecinos. */
  .lt-tarjeta {
    visibility: hidden;
    opacity: 0;
    /* Se apaga con un retraso corto: da tiempo a llevar el cursor del punto a la tarjeta. */
    transition:
      opacity 0.12s,
      visibility 0s linear 0.35s;
    position: absolute;
    /* A un costado del punto, como cualquier tooltip: a la derecha del punto y centrada en el eje
       (los puntos de las filas alta y baja están corridos, --dy). Un lector señaló que centrada
       sobre el punto quedaba debajo del cursor y había que moverse mucho para salir del hover; y
       después, que a un costado no se llegaba a ella con el cursor. La tarjeta forma parte del
       enlace del punto (clic en cualquier parte de ella abre el registro) y un puente invisible
       cubre el hueco entre el punto y la tarjeta para que el hover no se corte en el camino. */
    left: calc(50% + 0.9rem);
    top: 50%;
    transform: translateY(calc(-50% - var(--dy, 0rem)));
    width: 19rem;
    max-height: 11.5rem;
    overflow: hidden;
    padding: 0.5rem 0.65rem;
    background: var(--fondo);
    color: var(--texto);
    border: 1px solid var(--borde);
    border-left: 0.35rem solid var(--c, var(--acento));
    border-radius: 6px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
    font-size: var(--t-sm);
    line-height: 1.3;
    text-align: left;
  }
  .lt-punto:hover .lt-tarjeta,
  .lt-punto:focus .lt-tarjeta,
  .lt-punto:focus-within .lt-tarjeta {
    visibility: visible;
    opacity: 1;
    transition-delay: 0s;
  }
  /* El puente: un rectángulo invisible entre el punto y la tarjeta, solo mientras hay hover. */
  .lt-punto:hover::after,
  .lt-punto:focus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.2rem;
    height: 4rem;
    transform: translateY(calc(-50% - var(--dy, 0rem)));
  }
  /* Cerca del borde derecho de la cinta, o del borde visible (clase `lado-izq`, la pone el script
     al pasar el cursor), la tarjeta se abre hacia la izquierda del punto. */
  .borde-der .lt-tarjeta,
  .lado-izq .lt-tarjeta {
    left: auto;
    right: calc(50% + 0.9rem);
  }
  .borde-der:hover::after,
  .lado-izq:hover::after,
  .borde-der:focus::after,
  .lado-izq:focus::after {
    left: auto;
    right: 50%;
  }
  .lt-tarjeta-fecha,
  .lt-tarjeta-origen,
  .lt-tarjeta-accion {
    display: block;
    color: var(--texto-3);
    font-size: 0.85em;
  }
  .lt-tarjeta-titulo {
    display: block;
    font-weight: 600;
    margin: 0.15rem 0;
  }
  .lt-tarjeta-detalle {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 0.2rem;
  }
  .lt-tarjeta-accion {
    margin-top: 0.2rem;
    color: var(--acento);
  }
  .lt-nota {
    color: var(--texto-3);
    margin: 0.25rem 0 var(--e-2);
  }
  .lt-c1 {
    --c: #1f77b4;
  }
  .lt-c2 {
    --c: #d62728;
  }
  .lt-c3 {
    --c: #2ca02c;
  }
  .lt-c4 {
    --c: #ff7f0e;
  }
  .lt-c5 {
    --c: #9467bd;
  }
  .lt-c6 {
    --c: #8c564b;
  }
  .lt-c7 {
    --c: #e377c2;
  }
  .lt-c8 {
    --c: #7f7f7f;
  }
  .lt-c9 {
    --c: #bcbd22;
  }
  .lt-c10 {
    --c: #17becf;
  }
  .lt-filtro a[class*='lt-c'] {
    border-left: 0.4rem solid var(--c);
  }
  .lt-n {
    color: var(--texto-3);
    font-size: 0.85em;
  }
  .lt-reset {
    font: inherit;
    font-size: var(--t-sm);
    border: 1px solid var(--borde);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    background: none;
    color: var(--texto-3);
    cursor: pointer;
  }
  .lt-reset:hover {
    color: var(--texto);
    border-color: var(--texto);
  }
  /* Foco (hover o temas fijados): lo que no está en el conjunto se atenúa, sin reflow. El resaltado
     del chip no usa negrita a propósito: el cambio de ancho movería el resto de la fila. */
  .lt-filtro a,
  .lt-punto {
    transition: opacity 0.12s;
  }
  .lt.focus .lt-filtro a[data-tema]:not(.on) {
    opacity: 0.4;
  }
  .lt.focus .lt-filtro a[data-tema].on {
    opacity: 1;
    box-shadow: inset 0 0 0 1px var(--c, var(--acento));
    border-color: var(--c, var(--acento));
  }
  .lt-filtro a[data-tema][aria-pressed='true'] {
    background: color-mix(in srgb, var(--c, var(--acento)) 18%, transparent);
  }
  .lt-filtro a.hl {
    opacity: 1 !important;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .lt.focus .lt-punto:not(.on) {
    opacity: 0.15;
    pointer-events: none;
  }
  .lt.focus .lt-punto.on {
    z-index: 2;
  }
</style>

<script>
  /* Mismo comportamiento que las gráficas de series con leyenda: pasar el cursor por un tema atenúa
     los demás puntos; clic fija el tema (y se pueden fijar varios, para ver un grupo elegido); pasar
     el cursor por un punto subraya su tema en la leyenda aunque esté atenuado; «✕ quitar filtros»
     aparece cuando hay algo fijado. */
  for (const raiz of document.querySelectorAll<HTMLElement>('.lt')) {
    const filtro = raiz.querySelector<HTMLElement>('.lt-filtro');
    if (!filtro) continue;
    raiz.classList.add('js');
    const chips = [...filtro.querySelectorAll<HTMLAnchorElement>('a[data-tema]')];
    const puntos = [...raiz.querySelectorAll<HTMLElement>('.lt-punto[data-tema]')];
    const reset = filtro.querySelector<HTMLButtonElement>('.lt-reset');
    const todos = filtro.querySelector<HTMLAnchorElement>('.lt-todos');
    const fijados = new Set<string>();
    const chipDe = (tema: string | undefined) => chips.find((c) => c.dataset.tema === tema);
    const aplicar = (claves: Set<string>) => {
      raiz.classList.toggle('focus', claves.size > 0);
      for (const p of puntos) p.classList.toggle('on', claves.has(p.dataset.tema ?? ''));
      for (const c of chips) {
        c.classList.toggle('on', claves.has(c.dataset.tema ?? ''));
        c.setAttribute('aria-pressed', String(fijados.has(c.dataset.tema ?? '')));
      }
      if (reset) reset.hidden = fijados.size === 0;
    };
    for (const c of chips) {
      const tema = c.dataset.tema ?? '';
      c.addEventListener('mouseenter', () => aplicar(new Set([...fijados, tema])));
      c.addEventListener('mouseleave', () => aplicar(new Set(fijados)));
      c.addEventListener('click', (ev) => {
        ev.preventDefault();
        if (fijados.has(tema)) fijados.delete(tema);
        else fijados.add(tema);
        aplicar(new Set(fijados));
        // Al fijar, la cinta se corre hasta el punto más reciente del conjunto elegido, que puede
        // estar varias pantallas a la izquierda del extremo reciente donde arranca.
        const reciente = puntos.filter((p) => p.classList.contains('on')).at(-1);
        reciente?.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      });
    }
    /* La tarjeta se abre a la derecha del punto salvo que no entre en la parte visible de la cinta:
       ahí se abre a la izquierda. Se decide al pasar el cursor, con el ancho real de la tarjeta. */
    const scroll = lt.querySelector<HTMLElement>('.lt-scroll');
    const ladoDe = (p: HTMLElement) => {
      const tarjeta = p.querySelector<HTMLElement>('.lt-tarjeta');
      const caja = scroll?.getBoundingClientRect();
      if (!tarjeta || !caja) return;
      const ancho = tarjeta.offsetWidth || 19 * 16;
      const x = p.getBoundingClientRect().left + p.offsetWidth / 2;
      p.classList.toggle('lado-izq', x + 16 + ancho > caja.right && x - 16 - ancho > caja.left);
    };
    for (const p of puntos) {
      p.addEventListener('mouseenter', () => ladoDe(p));
      p.addEventListener('focus', () => ladoDe(p));
      const c = chipDe(p.dataset.tema);
      if (!c) continue;
      const prender = () => c.classList.add('hl');
      const apagar = () => c.classList.remove('hl');
      p.addEventListener('mouseenter', prender);
      p.addEventListener('mouseleave', apagar);
      p.addEventListener('focus', prender);
      p.addEventListener('blur', apagar);
    }
    const limpiar = (ev?: Event) => {
      ev?.preventDefault();
      fijados.clear();
      aplicar(new Set());
    };
    reset?.addEventListener('click', limpiar);
    todos?.addEventListener('click', limpiar);
    // Un enlace con el ancla de un tema (llegado desde otra página) fija ese tema.
    const m = location.hash.match(new RegExp(`^#${raiz.id}-tema-(.+)$`));
    if (m) {
      const tema = m[1].replaceAll('--', '/');
      if (chipDe(tema)) {
        fijados.add(tema);
        aplicar(new Set(fijados));
      }
    }
  }
</script>
