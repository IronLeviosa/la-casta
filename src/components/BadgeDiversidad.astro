---
/**
 * "3 medios · 2 grupos · 2 alineamientos". Avisa cuando hay menos de dos
 * grupos de propiedad: la evidencia depende de una sola familia de medios.
 * El aviso es solo para `reportado`; con `nivel` textual o inferencia se
 * muestran los números sin la advertencia (ver `avisoDeDiversidad`).
 */
import { getCollection } from 'astro:content';
import { avisoDeDiversidad, calcularDiversidad, mapaMedios, type FuenteMinima, type NivelDeEvidencia } from '../lib/diversidad';
import { plural } from '../lib/formato';

interface Props {
  fuentes: readonly FuenteMinima[];
  nivel?: NivelDeEvidencia;
}
const { fuentes, nivel } = Astro.props;
const medios = mapaMedios(await getCollection('medios'));
const d = calcularDiversidad(fuentes, medios);
const texto = `${d.medios} ${plural(d.medios, 'medio', 'medios')} · ${d.grupos} ${plural(d.grupos, 'grupo', 'grupos')} · ${d.alineamientos} ${plural(d.alineamientos, 'alineamiento', 'alineamientos')}`;
const aviso = avisoDeDiversidad(d, nivel);
const ayuda = aviso
  ? 'Todas las fuentes pertenecen a un mismo grupo de propiedad; la independencia entre fuentes no está garantizada.'
  : d.advertencia && nivel === 'textual'
    ? 'Registro primario (documento oficial, diario de sesiones o video): la regla de dos grupos de propiedad es para lo que cuenta la prensa.'
    : 'Cantidad de medios, grupos de propiedad y alineamientos editoriales distintos entre las fuentes.';
---

<span class:list={['insignia', aviso && 'insignia-aviso']} title={ayuda}>
  {aviso && <span class="icono" aria-hidden="true">⚠</span>}
  <span>{texto}</span>
  {aviso && <span class="visualmente-oculto">. Aviso: un solo grupo de propiedad.</span>}
</span>
